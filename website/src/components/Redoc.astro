// Renders an OpenAPI description with Redoc, following the site's light or dark theme.
interface Props {
  spec: string;
}
const { spec } = Astro.props;
---

<div class="not-content redoc-wrap" data-spec={spec}></div>
<script is:inline src="https://cdn.redoc.ly/redoc/v2.5.1/bundles/redoc.standalone.js"></script>
<script is:inline>
  (function () {
    const el = document.currentScript.previousElementSibling.previousElementSibling;
    const dark = document.documentElement.dataset.theme === 'dark';
    const text = dark ? '#e6e9f5' : '#1b2033';
    Redoc.init(el.dataset.spec, {
      expandResponses: '200,201',
      hideDownloadButton: false,
      theme: {
        colors: { primary: { main: dark ? '#8aa4ff' : '#3550c8' }, text: { primary: text } },
        typography: { fontSize: '15px', fontFamily: 'inherit', headings: { fontFamily: 'inherit' } },
        sidebar: { width: '0px' },
        rightPanel: { backgroundColor: '#1b2a6b' },
      },
    }, el);
  })();
</script>

<style>
  .redoc-wrap { margin-top: 2rem; border-radius: 0.75rem; overflow: hidden; }
  :global([data-theme='dark']) .redoc-wrap { background: #f5f6fb; }
</style>
