package ui

import "time"

templ timeAgo(t time.Time) {
	if t.IsZero() {
		<span class="faint">never</span>
	} else {
		<time datetime={ iso(t) } data-ago>{ short(t) }</time>
	}
}

templ timeline(events []EventView, showService bool) {
	if len(events) == 0 {
		<div class="empty">No history yet. Events appear when versions change, releases ship or drift opens.</div>
	} else {
		<ol class="timeline">
			for _, e := range events {
				<li>
					@timeAgo(e.At)
					<div class="ev">
						<span class={ "kind", e.Type }>{ e.Label }</span>
						<span class="what">{ e.Text }</span>
						if showService && e.ServiceURL != "" {
							<a class="where" href={ templ.URL(e.ServiceURL) }>{ e.Service }</a>
						}
						if e.Ask != "" {
							<button type="button" class="link ask-goli noprint" data-goli-ask={ e.Ask } title="Goli looks at everything else that changed around this time">Around this</button>
						}
					</div>
				</li>
			}
		</ol>
	}
}

templ secret(label, value string) {
	<div class="secret" role="status">
		<strong>{ label }</strong>
		<code id="secret-value">{ value }</code>
		<button type="button" class="secondary" data-copy="secret-value">Copy</button>
		<span class="muted">It is shown only once.</span>
	</div>
}

// about is a page's explanation, folded: a short "About this page" that shows it on hover (its title) and opens on
// a click or a tap. title is the plain text for the tooltip; the children are the explanation.
templ about(title string) {
	<details class="about">
		<summary title={ title }>About this page</summary>
		<div class="about-text">
			{ children... }
		</div>
	</details>
}

// aboutText is about with plain text.
templ aboutText(text string) {
	@about(text) {
		{ text }
	}
}

// panelInfo is a panel's explanation as an icon in its header: hovering shows it, a click or a tap opens it under
// the icon.
templ panelInfo(text string) {
	<details class="panel-info">
		<summary title={ text } aria-label={ "About: " + text }></summary>
		<div class="panel-info-text">{ text }</div>
	</details>
}
