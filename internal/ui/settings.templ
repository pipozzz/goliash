package ui

templ NotificationsPage(v NotificationsView) {
	@Layout(v.Base) {
		<div class="head">
			<div>
				<h1>Notifications</h1>
				<p class="sub">Rules send events to channels, right away or as a daily or weekly digest.</p>
			</div>
			<span class="actions"><a href="/notifications/deliveries">Delivery log</a></span>
		</div>
		<div class="notif-panels">
			<section class="panel">
				<div class="panel-head"><h2>Channels</h2></div>
				if v.PushKey != "" {
					<div class="push-note" data-push-key={ v.PushKey } hidden></div>
				}
				if v.PushWarning {
					<p class="push-note bad">
						iPhones, iPads and Safari get no web push from this server: Apple's push service needs to know who sends, an https address. Set <code>GOLIASH_PUBLIC_URL</code> to the https address people open Goliash at (or <code>GOLIASH_PUSH_SUBJECT</code> to <code>mailto:you@example.com</code>) and restart. Chrome, Edge and Firefox work already.
					</p>
				}
				if len(v.Channels) == 0 {
					<div class="empty">
						<p><strong>No channels yet.</strong></p>
						<p>A channel is where notifications go: Slack, Microsoft Teams, Google Chat, Discord, Telegram, ntfy, Grafana annotations, a webhook, e-mail, browsers (web push) or only the bell in Goliash.</p>
					</div>
				} else {
					<div class="scroll">
						<table>
							<thead><tr><th>Name</th><th>Type</th><th>Where</th><th><span class="sr-only">Actions</span></th></tr></thead>
							<tbody>
								for _, c := range v.Channels {
									<tr>
										<td><strong>{ c.Name }</strong></td>
										<td>{ c.Type }</td>
										<td class="mono muted">{ c.Detail }</td>
										<td class="num">
											if c.Type == "push" {
												<div class="row-actions push-actions">
													<button class="link" type="button" data-push="subscribe" data-channel={ c.ID } hidden>Notify this browser</button>
													<button class="link" type="button" data-push="unsubscribe" data-channel={ c.ID } hidden>Stop on this browser</button>
												</div>
											}
											if v.CanAdmin {
												<div class="row-actions">
													<form method="post" action={ templ.URL("/notifications/channels/" + c.ID + "/test") }>
														<button class="link" type="submit">Send test</button>
													</form>
													<a href={ templ.URL("/notifications/channels/" + c.ID) }>Edit</a>
													<form method="post" action={ templ.URL("/notifications/channels/" + c.ID + "/delete") } hx-confirm={ "Delete channel " + c.Name + " and its rules?" }>
														<button class="link danger-link" type="submit">Delete</button>
													</form>
												</div>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
				if v.CanAdmin {
					<div class="panel-body" style="border-top:1px solid var(--line)">
						<details>
							<summary>Add a channel</summary>
							<form class="stack" method="post" action="/notifications/channels">
								<div class="row">
									<label>Name<input name="name" required placeholder="ops"/></label>
									<label>
										Type
										<select name="type" data-channel-type>
											<option value="slack">Slack (incoming webhook)</option>
											<option value="discord">Discord (channel webhook)</option>
											<option value="teams">Microsoft Teams (Workflows webhook)</option>
											<option value="gchat">Google Chat (space webhook)</option>
											<option value="telegram">Telegram (bot)</option>
											<option value="ntfy">ntfy</option>
											<option value="grafana">Grafana annotations</option>
											<option value="webhook">Webhook</option>
											<option value="email">E-mail</option>
											<option value="push">Web push (browsers)</option>
											<option value="inapp">In Goliash (the bell)</option>
										</select>
									</label>
								</div>
								<label data-for="slack discord teams gchat webhook ntfy grafana">URL<input name="url" type="url" placeholder="https://hooks.slack.com/services/…"/><span class="hint">The webhook URL (Slack, Discord, a Teams workflow, a Google Chat space), Grafana's address, or an ntfy topic such as https://ntfy.sh/my-goliash.</span></label>
								<label data-for="webhook">Signing secret<input name="secret" autocomplete="off"/><span class="hint">Webhook only: bodies are signed with HMAC-SHA256.</span></label>
								<div class="row" data-for="telegram ntfy grafana">
									<label>Token<input name="token" autocomplete="off"/><span class="hint">Telegram bot token, a Grafana service account token, or an ntfy access token (optional).</span></label>
									<label data-for="telegram">Chat ID<input name="chat_id" placeholder="-1001234567890"/><span class="hint">Telegram only.</span></label>
								</div>
								<label data-for="email">
									Recipients<input name="to" placeholder="oncall@example.com, ops@example.com"/>
									<span class="hint">Comma-separated.</span>
								</label>
								<p class="hint" data-for="push">Nothing to set up here: after adding the channel, press <strong>Notify this browser</strong> next to it in each browser that should get its notifications (on phones, add Goliash to the home screen first).</p>
								<p class="hint" data-for="inapp">Nothing to set up: messages show under the bell at the top of every page, for everyone in the workspace, and on the app icon when Goliash is installed.</p>
								<details class="smtp" data-for="email" open?={ !v.SMTP }>
									<summary>
										if v.SMTP {
											Own mail server (optional; else the server's relay)
										} else {
											Mail server (this server has no relay)
										}
									</summary>
									@smtpFields("", "", "", false, "")
								</details>
								<div><button type="submit">Add channel</button></div>
							</form>
						</details>
					</div>
				}
			</section>
			<section class="panel">
				<div class="panel-head"><h2>Rules</h2></div>
				if len(v.Rules) == 0 {
					<div class="empty">
						<p><strong>No rules yet: nothing is sent.</strong></p>
						if len(v.Channels) == 0 {
							<p>Add a channel first, then a rule that picks the events to send there.</p>
						} else {
							<p>Add a rule below to pick which events go to a channel, right away or as a digest.</p>
						}
					</div>
				} else {
					<div class="scroll">
						<table>
							<thead>
								<tr>
									<th>Events</th>
									<th>Filter</th>
									<th>Mode</th>
									<th>Channel</th>
									if v.CanMember {
										<th><span class="sr-only">Actions</span></th>
									}
								</tr>
							</thead>
							<tbody>
								for _, r := range v.Rules {
									<tr class={ templ.KV("paused", r.Paused) }>
										<td>
											{ r.Events }
											if r.Paused {
												<span class="badge neutral">paused</span>
											}
										</td>
										<td class="muted">{ r.Filter }</td>
										<td>{ r.Mode }</td>
										<td>{ r.Channel }</td>
										if v.CanMember {
											<td class="num">
												<div class="row-actions">
													if r.Plan {
														<form method="post" action={ templ.URL("/notifications/rules/" + r.ID + "/plan") }>
															<button class="link" type="submit" title="Send the upgrade plan now, to check the channel and the filters">Send plan now</button>
														</form>
													}
													<form method="post" action={ templ.URL("/notifications/rules/" + r.ID + "/pause") }>
														<input type="hidden" name="paused" value={ boolStr(!r.Paused) }/>
														<button class="link" type="submit">
															if r.Paused {
																Resume
															} else {
																Pause
															}
														</button>
													</form>
													<a href={ templ.URL("/notifications/rules/" + r.ID) }>Edit</a>
													<form method="post" action={ templ.URL("/notifications/rules/" + r.ID + "/delete") } hx-confirm="Delete this rule?">
														<button class="link danger-link" type="submit">Delete</button>
													</form>
												</div>
											</td>
										}
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
				if v.CanMember && len(v.Channels) > 0 {
					<div class="panel-body" style="border-top:1px solid var(--line)">
						<details>
							<summary>Add a rule</summary>
							<form class="stack" method="post" action="/notifications/rules">
								@ruleFields(v.Channels, NewRuleForm())
								<div><button type="submit">Add rule</button></div>
							</form>
						</details>
					</div>
				}
			</section>
		</div>
		if len(v.Deliveries) > 0 {
			<section class="panel">
				<div class="panel-head"><h2>Recent deliveries</h2><span class="muted">the last { itoa(len(v.Deliveries)) }, newest first · <a href="/notifications/deliveries">all of the last 30 days</a></span></div>
				@deliveriesTable(v.Deliveries, v.CanMember, "/notifications")
			</section>
		}
	}
}

templ SettingsPage(v SettingsView) {
	@Layout(v.Base) {
		<div class="head">
			<div>
				<h1>Users and API tokens</h1>
				<p class="sub">Viewers read. Members map services, edit policies and acknowledge. Admins manage agents, channels and users.</p>
			</div>
		</div>
		if v.Secret != "" {
			@secret(v.SecretLabel, v.Secret)
		}
		<section class="panel">
			<div class="panel-head"><h2>People in { v.Workspace }</h2></div>
			<div class="scroll">
				<table>
					<thead><tr><th>E-mail</th><th>Access</th><th>Password</th><th>2FA</th><th>Last sign-in</th><th><span class="sr-only">Actions</span></th></tr></thead>
					<tbody>
						for _, u := range v.Users {
							<tr>
								<td><strong>{ u.Email }</strong></td>
								<td>
									if u.IsSelf || (u.OrgWide && !v.OrgAdmin) || (u.OrgRole == "owner" && !v.CanGrantOwner) {
										{ u.Access }
									} else {
										<form class="inline" method="post" action={ templ.URL("/settings/users/" + u.ID + "/role") }>
											<select name="role" aria-label="Role" data-autosubmit>
												for _, r := range workspaceRoles() {
													<option value={ r } selected?={ !u.OrgWide && (r == u.Role || (r == "none" && u.Role == "")) }>{ roleLabel(r) }</option>
												}
												if v.OrgAdmin {
													<option value="org-admin" selected?={ u.OrgRole == "admin" }>admin of the organization</option>
												}
												if v.CanGrantOwner {
													<option value="owner" selected?={ u.OrgRole == "owner" }>owner of the organization</option>
												}
											</select>
										</form>
									}
								</td>
								<td>
									if u.HasPassword {
										<span class="badge ok">set</span>
									} else {
										<span class="badge neutral">none</span>
									}
								</td>
								<td>
									if u.TOTP {
										<span class="badge ok">on</span>
									} else {
										<span class="badge neutral">off</span>
									}
								</td>
								<td>@timeAgo(u.LastLogin)</td>
								<td class="num">
									if !u.IsSelf && (!u.OrgWide || v.OrgAdmin) {
										<form class="inline" method="post" action={ templ.URL("/settings/users/" + u.ID + "/link") }>
											<button class="link" type="submit">Sign-in link</button>
										</form>
										<form class="inline" method="post" action={ templ.URL("/settings/users/" + u.ID + "/sign-out") } hx-confirm="Sign this person out on every device?">
											<button class="link" type="submit">Sign out</button>
										</form>
										if u.TOTP {
											<form class="inline" method="post" action={ templ.URL("/settings/users/" + u.ID + "/2fa/delete") } hx-confirm="Turn off this person's two-factor sign-in and sign them out everywhere?">
												<button class="link" type="submit">Reset 2FA</button>
											</form>
										}
										if u.HasPassword {
											<form class="inline" method="post" action={ templ.URL("/settings/users/" + u.ID + "/password/delete") } hx-confirm="Remove this person's password and sign them out everywhere?">
												<button class="link" type="submit">Remove password</button>
											</form>
										}
									}
									if !u.IsSelf && v.OrgAdmin {
										<form class="inline" method="post" action={ templ.URL("/settings/users/" + u.ID + "/delete") } hx-confirm="Remove this person from the organization?">
											<button class="link" type="submit" style="color:var(--bad)">Remove</button>
										</form>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<div class="panel-body" style="border-top:1px solid var(--line)">
				<form class="inline" method="post" action="/settings/users">
					<label>E-mail<input name="email" type="email" required/></label>
					<label>
						Access
						<select name="role">
							<option value="viewer">viewer of { v.Workspace }</option>
							<option value="member">member of { v.Workspace }</option>
							<option value="admin">admin of { v.Workspace }</option>
							if v.OrgAdmin {
								<option value="org-admin">admin of the organization</option>
							}
							if v.CanGrantOwner {
								<option value="owner">owner of the organization</option>
							}
						</select>
					</label>
					<button type="submit">Invite</button>
				</form>
				<p class="hint">Inviting someone who already has an account gives them access to this workspace too. Without e-mail, send them the sign-in link shown after inviting.</p>
			</div>
		</section>
		if v.CanGrantOwner {
			<section class="panel">
				<div class="panel-head">
					<h2>Two-factor sign-in</h2>
					if v.Require2FA {
						<span class="badge ok">required</span>
					} else {
						<span class="badge neutral">optional</span>
					}
				</div>
				<div class="panel-body stack">
					<p class="muted">When required, everyone who signs in with a password or a link sets up an authenticator app before they can do anything else. Single sign-on is left to the identity provider.</p>
					<form method="post" action="/settings/require-2fa">
						if v.Require2FA {
							<input type="hidden" name="require" value="false"/>
							<button type="submit" class="secondary">Make it optional</button>
						} else {
							<input type="hidden" name="require" value="true"/>
							<button type="submit" disabled?={ !v.SelfHas2FA }>Require it for everyone</button>
							if !v.SelfHas2FA {
								<span class="hint">Set it up for yourself first, on <a href="/account">your account page</a>.</span>
							}
						}
					</form>
				</div>
			</section>
		}
		@registriesPanel(v)
		<section class="panel">
			<div class="panel-head"><h2>Applications</h2><span class="muted">how the target page groups workloads</span></div>
			<div class="panel-body stack">
				<p class="muted">A workload's application comes from its labels: goliash.app or app.kubernetes.io/part-of, then the Helm release, the Compose project or the Swarm stack, else its namespace. Name your own label to have it checked first.</p>
				<form class="inline" method="post" action="/settings/app-label">
					<label>
						Label key
						<input name="key" value={ v.AppLabel } placeholder="example.com/app" spellcheck="false" autocomplete="off"/>
					</label>
					<button type="submit" class="secondary">Save</button>
				</form>
				<p class="hint">Applies from each target's next snapshot. Leave it empty for the well-known labels only.</p>
			</div>
		</section>
		<section class="panel">
			<div class="panel-head"><h2>API tokens</h2><span class="muted">{ "for " + v.Workspace }</span></div>
			if len(v.Tokens) > 0 {
				<div class="scroll">
					<table>
						<thead><tr><th>Name</th><th>Role</th><th>Created</th><th>Last used</th><th>Expires</th><th><span class="sr-only">Actions</span></th></tr></thead>
						<tbody>
							for _, t := range v.Tokens {
								<tr>
									<td><strong>{ t.Name }</strong></td>
									<td>{ t.Role }</td>
									<td>
										@timeAgo(t.CreatedAt)
										if t.CreatedBy != "" {
											<div class="targets">by { t.CreatedBy }</div>
										}
									</td>
									<td>@timeAgo(t.LastUsed)</td>
									<td>
										if t.Expired {
											<span class="badge stale">expired</span>
										} else if t.ExpiresAt.IsZero() {
											<span class="muted">never</span>
										} else {
											<time datetime={ iso(t.ExpiresAt) }>{ t.ExpiresAt.UTC().Format("2006-01-02") }</time>
										}
									</td>
									<td class="num">
										<form class="inline" method="post" action={ templ.URL("/settings/tokens/" + t.ID + "/revoke") } hx-confirm={ "Revoke " + t.Name + "? Whatever uses it stops working." }>
											<button class="link" type="submit" style="color:var(--bad)">Revoke</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			<div class="panel-body" style="border-top:1px solid var(--line)">
				<form class="inline" method="post" action="/settings/tokens">
					<label>Name<input name="name" required maxlength="100" placeholder="prometheus"/></label>
					<label>
						Role
						<select name="role">
							<option value="viewer" selected>viewer: reads</option>
							<option value="member">member: also acknowledges</option>
						</select>
					</label>
					<label>
						Expires
						<select name="expires">
							<option value="">never</option>
							<option value="30">in 30 days</option>
							<option value="90">in 90 days</option>
							<option value="365">in a year</option>
						</select>
					</label>
					<button type="submit">Create token</button>
				</form>
				<p class="hint">Send it as <code>Authorization: Bearer glsh_api_…</code>. It works with <code>/api/v1</code> (<a href="/api/v1/openapi.yaml" hx-boost="false">OpenAPI</a>) , <code>/metrics</code> and <code>/mcp</code>. Viewer tokens read; member tokens also acknowledge.</p>
			</div>
		</section>
		<section class="panel">
			<div class="panel-head"><h2>Audit log</h2><span class="muted">changes to configuration, tokens and roles, newest first</span></div>
			if len(v.Audit) == 0 {
				<div class="empty">Nothing recorded yet.</div>
			} else {
				<div class="scroll">
					<table>
						<thead><tr><th>When</th><th>Who</th><th>What</th><th>Details</th></tr></thead>
						<tbody>
							for _, e := range v.Audit {
								<tr>
									<td>@timeAgo(e.At)</td>
									<td>{ e.Actor }</td>
									<td class="mono">{ e.Action }</td>
									<td class="mono muted">{ e.Details }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
	}
}

// ruleEvents are the event kinds a rule can pick, with their labels.
var ruleEvents = [][2]string{
	{"new_release", "new releases"}, {"drift_detected", "drift"}, {"drift_resolved", "drift resolved"},
	{"version_changed", "deploys"}, {"removed", "removals"}, {"agent_stale", "stale agents"}, {"vulnerability", "exploited or critical vulnerabilities"}, {"updates_plan", "upgrade plan"},
}

// ruleFields are the fields of the add and edit rule forms.
templ ruleFields(channels []ChannelView, f RuleForm) {
	<div class="row">
		<label>
			Channel
			<select name="channel">
				for _, c := range channels {
					<option value={ c.Name } selected?={ c.Name == f.Channel }>{ c.Name }</option>
				}
			</select>
		</label>
		<label>
			Mode
			<select name="mode">
				<option value="instant" selected?={ f.Mode == "instant" }>right away</option>
				<option value="daily" selected?={ f.Mode == "daily" }>daily digest</option>
				<option value="weekly" selected?={ f.Mode == "weekly" }>weekly digest (Mondays)</option>
			</select>
		</label>
		<label>
			Digest at
			<select name="digest_hour">
				for h := 0; h < 24; h++ {
					<option value={ itoa(h) } selected?={ h == f.DigestHour }>{ twoDigits(h) }:00</option>
				}
			</select>
		</label>
		<label>
			Releases from
			<select name="min_jump">
				<option value="" selected?={ f.MinJump == "" }>any</option>
				<option value="minor" selected?={ f.MinJump == "minor" }>minor</option>
				<option value="major" selected?={ f.MinJump == "major" }>major</option>
			</select>
		</label>
	</div>
	<fieldset style="border:0;padding:0;margin:0;display:flex;gap:14px;flex-wrap:wrap">
		for _, e := range ruleEvents {
			<label class="check" title={ eventTitle(e[0]) }><input type="checkbox" name="events" value={ e[0] } checked?={ hasString(f.Events, e[0]) }/> { e[1] }</label>
		}
	</fieldset>
	<div class="row">
		<label>
			Time zone
			<input name="timezone" value={ f.Timezone } placeholder="UTC" list="timezones" autocomplete="off"/>
		</label>
		<label>
			Quiet from
			<select name="quiet_from">
				<option value="-1" selected?={ f.QuietFrom < 0 }>no quiet hours</option>
				for h := 0; h < 24; h++ {
					<option value={ itoa(h) } selected?={ h == f.QuietFrom }>{ twoDigits(h) }:00</option>
				}
			</select>
		</label>
		<label>
			to
			<select name="quiet_to">
				<option value="-1" selected?={ f.QuietTo < 0 }>—</option>
				for h := 0; h < 24; h++ {
					<option value={ itoa(h) } selected?={ h == f.QuietTo }>{ twoDigits(h) }:00</option>
				}
			</select>
		</label>
	</div>
	<p class="hint">The time zone (such as Europe/Bratislava) sets the digest hour and the quiet hours. Right-away rules hold what comes in the quiet hours and send it together when they end.</p>
	<datalist id="timezones">
		for _, z := range commonZones {
			<option value={ z }></option>
		}
	</datalist>
	<div class="row">
		<label>Services<input name="services" value={ f.Services } placeholder="all"/></label>
		<label>Owners<input name="owners" value={ f.Owners } placeholder="all"/></label>
		<label>Applications<input name="apps" value={ f.Apps } placeholder="all"/></label>
		<label>Environments<input name="envs" value={ f.Envs } placeholder="all"/></label>
	</div>
}

templ RulePage(v RuleEditView) {
	@Layout(v.Base) {
		<div class="head">
			<div>
				<p class="sub"><a href="/notifications">Notifications</a> /</p>
				<h1>Edit rule</h1>
			</div>
		</div>
		<section class="panel">
			<div class="panel-body">
				<form class="stack" method="post" action={ templ.URL("/notifications/rules/" + v.ID) }>
					@ruleFields(v.Channels, v.Form)
					<p class="hint">Notifications already queued keep their channel and time; the change applies to what comes next.</p>
					<div class="actions">
						<button type="submit">Save</button>
						<a class="button secondary" href="/notifications">Cancel</a>
					</div>
				</form>
			</div>
		</section>
	}
}

// commonZones are offered in the rule form's time zone field; any IANA name works.
var commonZones = []string{
	"UTC", "Europe/London", "Europe/Dublin", "Europe/Lisbon", "Europe/Paris", "Europe/Berlin", "Europe/Amsterdam",
	"Europe/Brussels", "Europe/Madrid", "Europe/Rome", "Europe/Vienna", "Europe/Prague", "Europe/Bratislava",
	"Europe/Warsaw", "Europe/Budapest", "Europe/Zurich", "Europe/Stockholm", "Europe/Oslo", "Europe/Copenhagen",
	"Europe/Helsinki", "Europe/Athens", "Europe/Bucharest", "Europe/Kyiv", "Europe/Istanbul", "America/New_York",
	"America/Chicago", "America/Denver", "America/Los_Angeles", "America/Toronto", "America/Sao_Paulo",
	"America/Mexico_City", "Asia/Dubai", "Asia/Kolkata", "Asia/Singapore", "Asia/Shanghai", "Asia/Tokyo",
	"Asia/Seoul", "Australia/Sydney", "Pacific/Auckland", "Africa/Johannesburg",
}

templ registriesPanel(v SettingsView) {
	<section class="panel" id="registries">
		<div class="panel-head"><h2>Private registries</h2><span class="muted">{ "for " + v.Workspace }</span></div>
		<div class="panel-body stack">
			<p class="muted">Give the server read access to a private registry and it checks its images itself: new releases, the version behind a moving tag, signatures, SBOMs and vulnerabilities. Without it, an agent reads them with credentials it finds next to it.</p>
			if len(v.Unread) > 0 {
				<ul class="unread-registries">
					for _, u := range v.Unread {
						<li>
							<code>{ u.Host }</code>
							<span class="muted">{ plural(u.Services, "service", "services") } only agents can check</span>
							if u.ECR {
								<span class="muted">Amazon ECR: the agent reads it with its IAM role (<code>ecr:ListImages</code>).</span>
							} else {
								<a class="link" href={ templ.URL("/settings?registry=" + u.Host + "#registries") }>Add credentials</a>
							}
						</li>
					}
				</ul>
			}
		</div>
		if len(v.Registries) > 0 {
			<div class="scroll">
				<table class="cards">
					<thead><tr><th>Registry</th><th>Username</th><th>Status</th><th>Added</th><th><span class="sr-only">Actions</span></th></tr></thead>
					<tbody>
						for _, c := range v.Registries {
							<tr>
								<td>
									<strong><code>{ c.Host }</code></strong>
									<div class="targets">{ plural(c.Services, "service", "services") }</div>
								</td>
								<td data-label="Username"><code>{ c.Username }</code></td>
								<td data-label="Status">
									if c.Error != "" {
										<span class="badge revoked" title={ c.Error }>refused</span>
										<div class="targets">{ c.Error }</div>
									} else if !c.UsedAt.IsZero() {
										<span class="badge ok">works</span>
										<div class="targets">used @timeAgo(c.UsedAt)</div>
									} else {
										<span class="muted">not used yet</span>
									}
								</td>
								<td data-label="Added">
									@timeAgo(c.CreatedAt)
									if c.CreatedBy != "" {
										<div class="targets">by { c.CreatedBy }</div>
									}
								</td>
								<td class="num" data-label="">
									<form class="inline" method="post" action={ templ.URL("/settings/registries/" + c.ID + "/delete") } hx-confirm={ "Remove the credentials for " + c.Host + "? Its images go back to the agents." }>
										<button class="link" type="submit" style="color:var(--bad)">Remove</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<div class="panel-body" style="border-top:1px solid var(--line)">
			if v.Encrypts {
				<form class="inline" method="post" action="/settings/registries" data-busy="Trying them…">
					<label>Registry<input name="host" required value={ v.RegistryHost } placeholder="registry.example.com" spellcheck="false" autocomplete="off" autofocus?={ v.RegistryHost != "" }/></label>
					<label>Username<input name="username" maxlength="200" placeholder="robot$goliash" spellcheck="false" autocomplete="off"/></label>
					<label>Password or token<input name="secret" type="password" required autocomplete="new-password"/></label>
					<button type="submit">Save and try</button>
				</form>
				<p class="hint">Use a read-only robot account or token: a Harbor or Quay robot, a GitLab deploy token (read_registry), a GitHub token with read:packages, a Docker Hub access token. Saved encrypted and never shown again; saving again replaces it. Amazon ECR tokens expire, so ECR stays with the agent and its IAM role.</p>
			} else {
				<p class="notice error">The server has no secret key, so it cannot store registry credentials. Set <code>GOLIASH_SECRET_KEY</code> (32 bytes, base64) and restart it.</p>
			}
		</div>
	</section>
}

// deliveriesTable lists notifications with how their delivery went, and a retry where it helps.
templ deliveriesTable(ds []DeliveryView, canRetry bool, ret string) {
				<div class="scroll">
					<table class="deliveries">
						<thead><tr><th>When</th><th>Channel</th><th>What</th><th>Status</th><th><span class="sr-only">Actions</span></th></tr></thead>
						<tbody>
							for _, d := range ds {
								<tr>
									<td class="muted nowrap">@timeAgo(d.At)</td>
									<td><strong>{ d.Channel }</strong> <span class="muted">{ d.Type }</span></td>
									<td class="delivery-text">{ d.Text }</td>
									<td>
										<span class={ "delivery-status " + d.Status }>{ d.Label }</span>
										if d.Error != "" && d.Status != "sent" {
											<div class="delivery-error mono">{ d.Error }</div>
										}
									</td>
									<td class="num">
										if d.Retry && canRetry {
											<form method="post" action={ templ.URL("/notifications/deliveries/" + d.ID + "/retry") }>
												<input type="hidden" name="return" value={ ret }/>
												<button class="link" type="submit">
													if d.Status == "waiting" {
														Send now
													} else {
														Retry now
													}
												</button>
											</form>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
}

// DeliveryLogPage lists every notification of the last 30 days, sent or not.
templ DeliveryLogPage(v SentView) {
	@Layout(v.Base) {
		<div class="head">
			<div>
				<p><a href="/notifications">Notifications</a> / delivery log</p>
				<h1>Delivery log</h1>
				<p class="sub">Every notification of the last 30 days: what went out through which channel, what waits for its digest or quiet hours, and what failed.</p>
			</div>
		</div>
		<form class="row" method="get" action="/notifications/deliveries">
			<label>
				Status
				<select name="status" data-autosubmit>
					for _, st := range []string{"all", "sent", "waiting", "retrying", "failed"} {
						<option value={ st } selected?={ st == v.Status }>{ st + " (" + itoa(v.Counts[st]) + ")" }</option>
					}
				</select>
			</label>
			<label>
				Channel
				<select name="channel" data-autosubmit>
					<option value="">every channel</option>
					for _, c := range v.Channels {
						<option value={ c.ID } selected?={ c.ID == v.Channel }>{ c.Name }</option>
					}
				</select>
			</label>
			<label class="grow">
				<span class="sr-only">Service or text</span>
				<input type="search" name="q" value={ v.Query } placeholder="Service, version or text"/>
			</label>
			<button type="submit" class="secondary">Show</button>
		</form>
		<section class="panel">
			if len(v.Deliveries) == 0 {
				<div class="empty">
					<p><strong>Nothing here.</strong></p>
					<p>Notifications appear when a rule sends an event to its channel; set up channels and rules under <a href="/notifications">Notifications</a>.</p>
				</div>
			} else {
				@deliveriesTable(v.Deliveries, v.CanMember, v.Return)
				if v.Hidden > 0 {
					<p class="hint" style="padding:0 16px 12px">{ "and " + itoa(v.Hidden) + " older; narrow the filter to see them" }</p>
				}
			}
		</section>
		<p class="hint">Notifications are kept for 30 days.</p>
	}
}
