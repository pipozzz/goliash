package ui

templ ChannelPage(v ChannelEditView) {
	@Layout(v.Base) {
		<div class="head">
			<div>
				<p class="sub"><a href="/notifications">Notifications</a> /</p>
				<h1>{ v.Name } <span class="badge neutral">{ v.Type }</span></h1>
			</div>
		</div>
		<section class="panel">
			<div class="panel-head"><h2>Edit channel</h2></div>
			<div class="panel-body">
				<form class="stack" method="post" action={ templ.URL("/notifications/channels/" + v.ID) } autocomplete="off">
					<label>Name<input name="name" value={ v.Name } required maxlength="100"/></label>
					switch v.Type {
						case "slack", "discord", "webhook", "ntfy", "grafana", "teams", "gchat":
							<label>
								URL
								<input name="url" type="url" placeholder={ v.URLHint }/>
								<span class="hint">Now { v.URLHint }. Leave empty to keep it; the full URL is not shown because it can be a secret.</span>
							</label>
					}
					if v.Type == "webhook" {
						<label>
							Signing secret
							<input name="secret" placeholder={ setHint(v.HasSecret) }/>
							<span class="hint">Bodies are signed with HMAC-SHA256. Leave empty to keep it.</span>
						</label>
					}
					switch v.Type {
						case "ntfy", "grafana", "telegram":
							<label>
								Token
								<input name="token" placeholder={ setHint(v.HasToken) }/>
								<span class="hint">Leave empty to keep it.</span>
							</label>
					}
					if v.Type == "telegram" {
						<label>Chat ID<input name="chat_id" value={ v.ChatID } required/></label>
					}
					if v.Type == "email" {
						<label>Recipients<input name="to" value={ v.To } required/><span class="hint">Comma-separated.</span></label>
						<fieldset class="smtp">
							<legend>Mail server</legend>
							<p class="hint">
								if v.SMTP {
									Optional: without one, mail goes through the server's relay (GOLIASH_SMTP_ADDR).
								} else {
									This server has no mail relay, so the channel needs its own.
								}
							</p>
							@smtpFields(v.SMTPAddr, v.SMTPFrom, v.SMTPUser, v.SMTPPass, v.SMTPTLS)
							if v.SMTPAddr != "" && v.SMTP {
								<label class="check"><input type="checkbox" name="smtp_clear" value="1"/> Use the server's relay instead</label>
							}
						</fieldset>
					}
					<div class="actions">
						<button type="submit">Save</button>
						<a class="button secondary" href="/notifications">Cancel</a>
					</div>
				</form>
			</div>
		</section>
	}
}

// smtpFields are a channel's own mail server settings; the password is never shown.
templ smtpFields(addr, from, user string, hasPass bool, mode string) {
	<div class="row">
		<label>Server<input name="smtp_addr" value={ addr } placeholder="smtp.example.com:587"/></label>
		<label>From<input name="smtp_from" value={ from } placeholder="goliash@example.com"/></label>
	</div>
	<p class="hint">Server as host:port. Encryption “Automatic” uses TLS on port 465, STARTTLS elsewhere. The password is encrypted at rest and never shown again.</p>
	<div class="row">
		<label>Username<input name="smtp_username" value={ user } autocomplete="off"/></label>
		<label>
			Password
			<input name="smtp_password" type="password" autocomplete="new-password" placeholder={ setHint(hasPass) }/>
		</label>
		<label>
			Encryption
			<select name="smtp_tls">
				<option value="" selected?={ mode == "" }>Automatic</option>
				<option value="starttls" selected?={ mode == "starttls" }>STARTTLS</option>
				<option value="tls" selected?={ mode == "tls" }>TLS</option>
				<option value="none" selected?={ mode == "none" }>None (a local relay)</option>
			</select>
		</label>
	</div>
}
