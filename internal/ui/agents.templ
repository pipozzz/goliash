package ui

templ AgentsPage(v AgentsView) {
	@Layout(v.Base) {
		<div class="head">
			<div>
				<h1>Agents and targets</h1>
				<p class="sub">Agents run in your network and read orchestrators read-only. Each target belongs to one environment.</p>
			</div>
			if v.CanAdmin {
				<a class="button" href="/connect">Connect a cluster or host</a>
			}
		</div>
		<section class="panel">
			<div class="panel-head"><h2>Agents</h2></div>
			if len(v.Agents) == 0 {
				<div class="empty">
					No agents yet.
					if v.CanAdmin {
						<a href="/connect">Connect a cluster or host</a> to add one.
					}
				</div>
			} else {
				<div class="scroll">
					<table>
						<thead><tr><th>Name</th><th>Status</th><th>Version</th><th>Host</th><th>Platforms</th><th>Last seen</th></tr></thead>
						<tbody>
							for _, a := range v.Agents {
								<tr>
									<td><a href={ templ.URL("/agents/" + a.ID) }><strong>{ a.Name }</strong></a></td>
									<td><span class={ "badge", a.Status }>{ a.Status }</span></td>
									<td class="mono">
										{ orDash(a.Version) }
										if a.Outdated {
											<span class="badge outdated">update available</span>
										}
									</td>
									<td class="mono">{ orDash(a.Hostname) }</td>
									<td>{ orDash(a.Platforms) }</td>
									<td>@timeAgo(a.LastSeen)</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
		<section class="panel">
			<div class="panel-head"><h2>Targets</h2></div>
			if len(v.Targets) == 0 {
				<div class="empty">
					No targets yet.
					if v.CanAdmin {
						<a href="/connect">Connect a cluster or host</a>: Kubernetes, Docker, Swarm, Nomad, ECS or Compose files.
					}
				</div>
			} else {
				@targetsTable(v.Targets, v.Moves, v.CanAdmin, "/agents")
			}
		</section>
		if v.CanAdmin {
			<section class="panel">
				<div class="panel-head"><h2>Environments</h2><span class="muted">in promotion order</span></div>
				if len(v.Envs) > 0 {
					<div class="scroll">
						<table class="envs">
							<thead><tr><th>Name</th><th>Order</th><th>Targets</th><th><span class="sr-only">Actions</span></th></tr></thead>
							<tbody>
								for _, e := range v.Envs {
									<tr>
										<td colspan="2">
											<form class="inline env-edit" method="post" action={ templ.URL("/environments/" + e.ID) }>
												<input name="name" value={ e.Name } required aria-label="Name" maxlength="60"/>
												<input name="position" value={ itoa(e.Position) } inputmode="numeric" aria-label="Order" size="4"/>
												<button class="secondary" type="submit">Save</button>
											</form>
										</td>
										<td>{ itoa(e.Targets) }</td>
										<td class="num">
											if e.Targets == 0 {
												<form method="post" action={ templ.URL("/environments/" + e.ID + "/delete") } hx-confirm={ "Delete environment " + e.Name + "?" }>
													<button class="link danger-link" type="submit">Delete</button>
												</form>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
				<div class="panel-body" style="border-top:1px solid var(--line)">
					<form class="inline" method="post" action="/environments">
						<label>Name<input name="name" required placeholder="staging"/></label>
						<label>Order<input name="position" inputmode="numeric" placeholder="20" size="5"/></label>
						<button type="submit">Create</button>
					</form>
					<p class="hint">Order sets promotion: lower comes first (dev 10, staging 20, prod 30). An environment behind the one before it is drift.</p>
				</div>
			</section>
			<details class="advanced">
				<summary>Advanced: add an agent or a target by hand, with JSON settings</summary>
				<div class="grid-2">
					<section class="panel">
						<div class="panel-head"><h2>Add an agent</h2></div>
						<div class="panel-body">
							<form class="inline" method="post" action="/agents">
								<label>Name<input name="name" required placeholder="eu-cluster"/></label>
								<button type="submit">Create agent</button>
							</form>
						</div>
					</section>
				</div>
				<section class="panel">
					<div class="panel-head"><h2>Add a target</h2></div>
					<div class="panel-body">
						if len(v.EnvNames) == 0 {
							<p class="muted">Create an environment first.</p>
						} else {
							<form class="stack" method="post" action="/targets">
								<div class="row">
									<label>Name<input name="name" required placeholder="prod-eu-1"/></label>
									<label>
										Platform
										<select name="platform">
											<option value="kubernetes">Kubernetes</option>
											<option value="ecs">ECS</option>
											<option value="nomad">Nomad</option>
											<option value="swarm">Docker Swarm</option>
											<option value="docker">Docker</option>
											<option value="compose">Compose files</option>
										</select>
									</label>
									<label>
										Environment
										<select name="environment">
											for _, e := range v.EnvNames {
												<option value={ e }>{ e }</option>
											}
										</select>
									</label>
									<label>
										Agent
										<select name="agent">
											for _, a := range v.AgentNames {
												<option value={ a }>{ a }</option>
											}
											<option value="">— the server itself</option>
										</select>
									</label>
								</div>
								<label>
									Settings (JSON)
									<textarea name="settings" rows="2" class="mono" placeholder={ `{"kubernetes":{"exclude_namespaces":["kube-system"]}}` }></textarea>
									<span class="hint">ECS: { `{"ecs":{"region":"eu-west-1"}}` } · Nomad: { `{"nomad":{"address":"https://nomad:4646"}}` } · Swarm or Docker: { `{"swarm":{"docker_host":"tcp://docker-socket-proxy:2375"}}` }, with "docker" for a standalone host · Compose: { `{"compose":{"files":["https://raw.githubusercontent.com/acme/infra/main/compose.yaml"]}}` }</span>
								</label>
								<div><button type="submit">Create target</button></div>
							</form>
						}
					</div>
				</section>
			</details>
		}
	}
}
