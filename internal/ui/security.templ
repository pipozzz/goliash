package ui

import (
	"net/url"
	"strings"
	"time"

	"github.com/pipozzz/goliash/internal/versions"
)

// SecurityPage is the security posture: patch latency, end of life, supply-chain findings and blind spots.
templ SecurityPage(v SecurityView) {
	@Layout(v.Base) {
		<div class="head">
			<div>
				<h1>Security posture</h1>
				@aboutText("How long " + orDash(v.Prod.Name) + " runs behind available releases, what is past its end of life, and where Goliash cannot see. Counted from when the first newer release came out; for risk registers and audits.")
			</div>
			<div class="actions noprint">
				@pageFilter("main table tbody tr", "Filter services, versions, packages")
				<a class="button secondary" href="/security.csv" hx-boost="false">Export CSV</a>
				<a class="button secondary" href="/api/v1/inventory?format=cyclonedx" hx-boost="false" title="CycloneDX 1.6 BOM of what runs, with the packages of each image's SBOM">Export SBOM</a>
				<button class="secondary" type="button" data-print>Print or save as PDF</button>
			</div>
		</div>
		if !v.AlertsOutside {
			<div class="unread-hint" role="status">
				<p>
					<strong>Exploited and critical vulnerabilities only reach the bell in Goliash.</strong>
					<span class="muted">Nobody hears of one until they open Goliash: send them to Slack, Teams or e-mail too.</span>
					<a class="link" href="/notifications">Add a rule</a>
				</p>
			</div>
		}
		@securityNav(v)
		@sinceYesterday(v)
		<div class="tiles">
			<a class={ "tile", templ.KV("warn", v.ProdMedian > 30), templ.KV("on", v.Show == "") } href={ templ.URL(securityHref(v, "") + "#exposure") } title="Every exposure">
				<strong>{ days(v.ProdMedian) }</strong>
				<span>Median exposure</span>
				<small>{ "90th percentile " + days(v.ProdP90) + ", in " + v.Prod.Name }</small>
			</a>
			<a class={ "tile", templ.KV("warn", v.Prod30 > 0), templ.KV("on", v.Show == "30") } href={ templ.URL(securityHref(v, "30") + "#exposure") } title="Only what has run behind for more than 30 days">
				<strong>{ itoa(v.Prod30) }</strong>
				<span>Behind for 30+ days</span>
				<small>{ itoa(v.Prod90) } of them 90+ days</small>
			</a>
			<a class={ "tile", templ.KV("warn", v.EOLPassed > 0), templ.KV("on", v.Show == "eol") } href={ templ.URL(securityHref(v, "eol") + "#exposure") } title="Only what runs past its end of life">
				<strong>{ itoa(v.EOLPassed) }</strong>
				<span>Past end of life</span>
				<small>{ itoa(v.EOLSoon) } more within 60 days</small>
			</a>
			<a class={ "tile", templ.KV("on", v.Show == "accepted") } href={ templ.URL(securityHref(v, "accepted") + "#exposure") } title="Only the exposures acknowledged as accepted risk">
				<strong>{ itoa(v.Accepted) }</strong>
				<span>Accepted risk</span>
				<small>acknowledged in Goliash, with who and until when</small>
			</a>
			<a class={ "tile", templ.KV("warn", len(v.Stale) > 0 || !v.DigestOK) } href="#blind-spots" title="Where the numbers may be incomplete">
				<strong>{ itoa(len(v.Stale) + len(v.NoUpstream) + v.NoDigest) }</strong>
				<span>Blind spots</span>
				<small>stale targets, targets without digests, services without a known upstream</small>
			</a>
		</div>
		if len(v.PatchMonths) > 0 {
			@patchChart(v)
		}
		if len(v.Teams) > 0 {
			@teamsPanel(v)
		}
		if len(v.Trend) > 0 {
			<section class="panel" id="trend">
				<div class="panel-head">
					<h2>{ "Trend in " + v.Prod.Name }</h2>
					<span class="muted">{ "since " + v.Since + ", recorded daily" }</span>
				</div>
				<div class="panel-body trend-grid">
					for i, t := range v.Trend {
						{{ line, area := sparkPaths(t.Values, t.Max, 150, 40) }}
						<div class="spark">
							<span class="spark-label">{ t.Label }</span>
							<svg viewBox="0 0 150 40" preserveAspectRatio="none" role="img" aria-label={ t.Label + " since " + v.Since + ": " + trendText(t) }>
								<defs>
									<linearGradient id={ "trend-g" + itoa(i) } x1="0" y1="0" x2="0" y2="1">
										<stop offset="0%" class="st-c0" stop-opacity="0.38"></stop>
										<stop offset="100%" class="st-c0" stop-opacity="0"></stop>
									</linearGradient>
								</defs>
								<line x1="0" x2="150" y1="39.5" y2="39.5"></line>
								if area != "" {
									<path class="spark-area" fill={ "url(#trend-g" + itoa(i) + ")" } d={ area }></path>
									<path class="spark-line" d={ line } vector-effect="non-scaling-stroke"></path>
								}
							</svg>
							<small class={ templ.KV("trend-better", t.Now < t.Was), templ.KV("trend-worse", t.Now > t.Was) }>{ trendText(t) }</small>
						</div>
					}
				</div>
			</section>
		}
		<section class="panel" id="exposure">
			<div class="panel-head">
				<h2>
					if v.All {
						Exposure in every environment
					} else {
						{ "Exposure in " + v.Prod.Name }
					}
					if v.Show != "" {
						<span class="muted">{ " · " + securityShowLabel(v.Show) }</span>
					}
				</h2>
				<span class="noprint">
					if v.Show != "" {
						<a href={ templ.URL(securityHref(v, "") + "#exposure") }>Show all</a>{ " · " }
					}
					if v.All {
						<a href={ templ.URL(securityHrefEnv(v, false)) }>{ "Only " + v.Prod.Name }</a>
					} else {
						<a href={ templ.URL(securityHrefEnv(v, true)) }>Every environment</a>
					}
				</span>
			</div>
			if len(v.Exposures) == 0 && v.Show != "" {
				<div class="empty">{ "Nothing " + securityShowLabel(v.Show) + "." }</div>
			} else if len(v.Exposures) == 0 {
				<div class="empty">Nothing runs behind a newer release{ " " }{ "in " + v.Prod.Name }.</div>
			} else {
				<div class="scroll" tabindex="0">
					<table>
						<thead><tr><th>Service</th><th>Running</th><th>Fix</th><th>Exposed</th><th>Why</th></tr></thead>
						<tbody>
							for _, ex := range v.Exposures {
								<tr>
									<td>
										<a href={ templ.URL(serviceURL(ex.Service.Name)) }><strong>{ ex.Service.Name }</strong></a>
										if ex.App != "" {
											<div class="targets">{ ex.App }</div>
										}
										if v.All {
											<div class="targets">{ ex.Environment.Name }</div>
										}
									</td>
									<td class="mono">
										{ ex.Running }
										if len(ex.On) > 0 {
											<div class="targets">{ "on " + strings.Join(ex.On, ", ") }</div>
										}
									</td>
									<td class="mono">
										if ex.TargetURL != "" {
											<a href={ templ.URL(ex.TargetURL) } target="_blank" rel="noopener noreferrer">{ ex.Target }</a>
										} else {
											{ orDash(ex.Target) }
										}
										for _, pr := range v.PRs[ex.Service.ID+"|"+ex.Environment.ID] {
											if pr.URL != "" {
												<div><a class="gitops-pr" href={ templ.SafeURL(pr.URL) } target="_blank" rel="noopener" title={ othersTitle(pr.Title) }>{ pullLabel(ex.Target, pr.State) }</a>@prChecks(pr.Checks)</div>
											} else {
												<div class="noprint"><a class="button secondary gitops-pr" href={ templ.URL(serviceURL(ex.Service.Name) + "/gitops/preview?" + previewQuery(pr.TargetID, pr.WorkloadID, ex.Target, "/security")) } title={ "See the pull request in the repository " + pr.App + " deploys from before opening it" }>
													Open PR
													if len(v.PRs[ex.Service.ID+"|"+ex.Environment.ID]) > 1 {
														{ " (" + pr.Target + ")" }
													}
												</a></div>
											}
										}
										if v.Goli && ex.Target != "" && ex.Running != "" {
											<div><button type="button" class="link ask-goli noprint" data-goli-ask={ explainExposure(ex) } title="Goli explains what this exposure means and what to do first">Explain</button></div>
										}
									</td>
									<td>
										if ex.Known {
											<span class={ "badge", exposureClass(ex) }>{ days(ex.Days) }</span>
											<div class="targets">since { ex.BehindSince.UTC().Format("2006-01-02") }</div>
										} else {
											<span class={ "badge", exposureClass(ex) } title="The release date is unknown; counted from when Goliash first saw the newer release">{ "≥ " + days(ex.Days) }</span>
											<div class="targets">seen { ex.BehindSince.UTC().Format("2006-01-02") }</div>
										}
									</td>
									<td>
										<div class="badges">
											if ex.EOL != "" {
												if ex.EOLPassed {
													<span class="badge eol">end of life { ex.EOL }</span>
												} else {
													<span class="badge eol">EOL { ex.EOL }</span>
												}
											}
											if ex.Jump != "" {
												<span class="badge upstream">{ string(ex.Jump) }</span>
											}
											if ex.Acked {
												<span class="badge neutral">accepted</span>
											}
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
		if len(v.Bases) > 0 {
			<section class="panel" id="bases">
				<div class="panel-head"><h2>Built on an unsupported base</h2>@panelInfo("rebuild on a newer base image")</div>
				<div class="scroll" tabindex="0">
					<table>
						<thead><tr><th>Service</th><th>Base image</th><th>End of life</th></tr></thead>
						<tbody>
							for _, b := range v.Bases {
								<tr>
									<td><a href={ templ.URL(serviceURL(b.Service)) }><strong>{ b.Service }</strong></a></td>
									<td class="mono" title={ b.Image }>
										{ b.Short }
										if b.Via != "" {
											<span class="muted">{ " under " + b.Via }</span>
										}
									</td>
									<td>
										if b.Passed {
											<span class="badge eol">ended { b.EOL }</span>
										} else {
											<span class="badge env">ends { b.EOL }</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		}
		if len(v.Vulns.Blind) > 0 {
			@sbomHelper(v.Vulns.Blind)
		}
		<section class="panel" id="vulnerabilities">
			<div class="panel-head"><h2>Is it running?</h2>@panelInfo("known vulnerabilities in " + v.Prod.Name + ", from the images' SBOMs and OSV")</div>
			<div class="panel-body stack">
				<form class="row vuln-search" method="get" action="/security/vulns">
					<label class="grow">
						<span class="sr-only">Vulnerability, package or service</span>
						<input name="q" placeholder="CVE-2024-3094, openssl, payments-api" required/>
					</label>
					<button type="submit">Check</button>
				</form>
				if v.Vulns.WithSBOM == 0 {
					<p class="hint">No running image has an SBOM Goliash could read yet. Build with <code>docker buildx build --sbom=true</code> (official images have one) and Goliash reads it from the registry.</p>
				} else {
					<p>
						<a href="/security/vulns"><strong>{ plural(len(v.Vulns.Findings), "known vulnerability", "known vulnerabilities") }</strong></a>
						{ " in " + plural(v.Vulns.Packages, "package", "packages") + " of " }
						{ itoa(v.Vulns.WithSBOM) } of { itoa(v.Vulns.Images) } images with an SBOM;
						{ itoa(v.Vulns.Fixable) } with a fixed version out.
						if v.Vulns.FromPackages > 0 {
							<span class="muted">{ plural(v.Vulns.FromPackages, "image has", "images have") + " no SBOM: Goliash read its system packages (dpkg, apk) from the image, not its application's dependencies." }</span>
						}
					</p>
					if v.Vulns.Exploited > 0 {
						<p class="notice error">
							<a href="/security/vulns?kev=1"><strong>{ plural(v.Vulns.Exploited, "vulnerability is", "vulnerabilities are") } exploited in the wild</strong></a> (CISA KEV): patch these first.
							if v.Vulns.PastDue > 0 {
								{ " " + plural(v.Vulns.PastDue, "of them runs past the date CISA set for fixing it.", "of them run past the dates CISA set for fixing them.") }
							}
						</p>
					}
				}
			</div>
		</section>
		if v.Licenses.WithSBOM > 0 {
			<section class="panel" id="licenses">
				<div class="panel-head"><h2>Licenses</h2>@panelInfo("packages in " + v.Prod.Name + ", as the images' SBOMs declare them")</div>
				<div class="panel-body stack">
					if n := licenseNeedsLook(v.Licenses); n > 0 {
						<p>
							<a href="/security/licenses"><strong>{ plural(n, "package needs", "packages need") } a look</strong></a>
							{ ": " + licenseSummary(v.Licenses) + "." }
						</p>
					} else {
						<p>Every application package with a license Goliash knows is under a permissive or weak copyleft license. <a class="u" href="/security/licenses?class=all">See them</a></p>
					}
				</div>
			</section>
		}
		if v.Evidence.Images > 0 {
			<section class="panel" id="evidence">
				<div class="panel-head"><h2>Supply-chain evidence</h2>@panelInfo("images running in " + v.Prod.Name + ": what their registry holds beside them")</div>
				<div class="tiles evidence">
					<div class="tile">
						<strong>{ percent(v.Evidence.Signed, v.Evidence.Checked) }</strong>
						<span>Signed</span>
						<small>{ itoa(v.Evidence.Signed) } of { itoa(v.Evidence.Checked) } checked: cosign, Sigstore or Notation</small>
					</div>
					<div class="tile">
						<strong>{ percent(v.Evidence.SBOM, v.Evidence.Checked) }</strong>
						<span>With an SBOM</span>
						<small>{ itoa(v.Evidence.SBOM) } of { itoa(v.Evidence.Checked) }: SPDX or CycloneDX attestation</small>
					</div>
					<div class="tile">
						<strong>{ percent(v.Evidence.Provenance, v.Evidence.Checked) }</strong>
						<span>With provenance</span>
						<small>{ itoa(v.Evidence.Provenance) } of { itoa(v.Evidence.Checked) }: SLSA, from the build</small>
					</div>
					<div class={ "tile", templ.KV("warn", v.Evidence.Unchecked > 0) }>
						<strong>{ itoa(v.Evidence.Unchecked) }</strong>
						<span>Not checked</span>
						<small>private registries or no digest known</small>
					</div>
				</div>
				if len(v.Evidence.Signers) > 0 || v.Evidence.NoSigner > 0 {
					<div class="panel-body">
						<h3 class="sub-head">Signed by</h3>
						<ul class="signers">
							for _, sg := range v.Evidence.Signers {
								<li>
									<span class="mono" title={ sg.Identity }>{ shortSigner(sg.Identity) }</span>
									<span class="muted">{ issuerName(sg.Issuer) + " · " + plural(sg.Images, "image", "images") }</span>
								</li>
							}
							if v.Evidence.NoSigner > 0 {
								<li><span class="muted">{ plural(v.Evidence.NoSigner, "image is", "images are") + " signed with a key, which names nobody" }</span></li>
							}
						</ul>
					</div>
				}
				<p class="hint panel-note">Goliash records that signatures and attestations exist and who keyless signatures' certificates name; it does not verify them. A service's version policy can name who should sign its images.</p>
				if len(v.Evidence.Unsigned) > 0 {
					<details class="unsigned">
						<summary>{ plural(len(v.Evidence.Unsigned), "unsigned image", "unsigned images") }</summary>
						<div class="scroll" tabindex="0">
							<table>
								<thead><tr><th>Image</th><th>Found</th></tr></thead>
								<tbody>
									for _, it := range v.Evidence.Unsigned {
										<tr>
											<td class="mono">{ it.Image }</td>
											<td>
												if len(it.Found) == 0 {
													<span class="muted">nothing</span>
												} else {
													{ strings.Join(it.Found, ", ") }
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</details>
				}
			</section>
		}
		<div class="grid-2">
			<section class="panel" id="supply-chain">
				<div class="panel-head"><h2>Supply chain</h2>@panelInfo("what runs, as images")</div>
				<div class="scroll" tabindex="0">
					<table>
						<tbody>
							@postureRow("Moving tags", "latest, stable: the version cannot be known", v.Hygiene["moving-tag"], "/hygiene?kind=moving-tag", true)
							@postureRow("Tags pushed again", "one tag running as different images", v.Hygiene["retagged"], "/hygiene?kind=retagged", true)
							@postureRow("Untrusted registries", "outside GOLIASH_ALLOWED_REGISTRIES", v.Hygiene["untrusted-registry"], "/hygiene?kind=untrusted-registry", true)
							@postureRow("Outdated base", "built on an older build of its FROM image", v.Hygiene["outdated-base"], "/hygiene?kind=outdated-base", true)
							@postureRow("Digest unknown", "a tag pushed again would go unnoticed", v.Hygiene["unpinned"], "/hygiene?kind=unpinned", false)
						</tbody>
					</table>
				</div>
			</section>
			<section class="panel" id="blind-spots">
				<div class="panel-head"><h2>Blind spots</h2>@panelInfo("where the numbers above may be incomplete")</div>
				<div class="panel-body stack">
					if len(v.Stale) == 0 {
						<p>Every target reported recently.</p>
					} else {
						<p><strong>{ plural(len(v.Stale), "stale target", "stale targets") }:</strong> { strings.Join(v.Stale, ", ") }. Their last known state counts.</p>
					}
					if len(v.NoUpstream) == 0 {
						<p>{ "The newest release is known for every service in " + v.Prod.Name + "." }</p>
					} else {
						if len(v.Unknowns) == 0 {
							<p><strong>{ itoa(len(v.NoUpstream)) } of { itoa(v.ProdRunning) } services</strong> have no known upstream release, so their exposure is not measured: { strings.Join(v.NoUpstream, ", ") }.</p>
						} else {
							<p><strong>{ itoa(len(v.NoUpstream)) } of { itoa(v.ProdRunning) } services</strong> have no known upstream release, so their exposure is not measured. Why, and what would let Goliash tell:</p>
							<ul class="unknowns">
								for _, u := range v.Unknowns {
									<li>
										<a class="u" href={ templ.URL("/services/" + url.PathEscape(u.Service)) }><strong>{ u.Service }</strong></a>{ ": " + u.Reason }
										if u.Fix != "" {
											{ " " + u.Fix }
										}
										if l := unknownFix(u); l.URL != "" {
											{ " " }<a class="u" href={ templ.URL(l.URL) }>{ l.Label }</a>
										}
									</li>
								}
							</ul>
						}
					}
					if !v.DigestOK {
						<p><strong>{ plural(v.NoDigest, "target", "targets") }</strong> report no image digests, so a tag pushed again would go unnoticed there; <a href="/hygiene?kind=unpinned">see why</a>.</p>
					}
				</div>
			</section>
		</div>
		if len(v.Watches) > 0 || v.CanWatch {
			@watchesPanel(v)
		}
		if v.Deadlines.Any() || v.CanSetDeadlines {
			@deadlinesPanel(v)
		}
		<p class="muted print-only">{ "Generated " + v.At.UTC().Format("2006-01-02 15:04 UTC") + " for " + v.Workspace + " by Goliash." }</p>
	}
}

templ postureRow(label, help string, n int, href string, warn bool) {
	<tr>
		<td><a class="u" href={ templ.URL(href) }>{ label }</a><div class="targets">{ help }</div></td>
		<td class="num">
			<span class={ "badge", templ.KV("env", warn && n > 0), templ.KV("neutral", !warn || n == 0) }>{ itoa(n) }</span>
		</td>
	</tr>
}

// days is a number of days as people read it.
func days(n int) string {
	if n == 1 {
		return "1 day"
	}
	return itoa(n) + " days"
}

var _ = time.Now

// explainExposure is what the Explain button asks Goli about a service running behind an available fix.
func explainExposure(ex versions.Exposure) string {
	return "Explain the exposure of " + ex.Service.Name + " in " + ex.Environment.Name + ": it runs " + ex.Running +
		" while " + ex.Target + " is out, for " + days(ex.Days) + ". What do the releases in between fix (security first), " +
		"what would the upgrade break, and what should we do first?"
}

// watchesPanel lists the security watches, each with the services it covers, and starts new ones.
templ watchesPanel(v SecurityView) {
	<section class="panel" id="watches">
		<div class="panel-head">
			<h2>Security watches</h2>
			@panelInfo("After an advance notice (\"PHP: two critical fixes on Oct 21\"), watch the software: Goliash shows what runs it and announces its next release the minute it sees it (the watch notification).")
		</div>
		for _, w := range v.Watches {
			<div class="panel-body watch">
				<div class="watch-head">
					<strong>{ "“" + w.Term + "”" }</strong>
					if w.Note != "" {
						<span>{ w.Note }</span>
					}
					<span class="muted">
						if w.Until != "" {
							{ "until " + w.Until }
						} else {
							until removed
						}
						if w.By != "" {
							{ " · by " + w.By }
						}
					</span>
					if v.CanWatch {
						<form method="post" action={ templ.URL("/security/watches/" + w.ID + "/delete") } class="inline">
							<button type="submit" class="link">Stop watching</button>
						</form>
					}
				</div>
				if len(w.Matches) == 0 {
					<p class="muted">Nothing that runs matches it now.</p>
				} else {
					<ul class="watch-matches">
						for _, m := range w.Matches {
							<li>
								<a class="u" href={ templ.URL("/services/" + url.PathEscape(m.Service)) }><strong>{ m.Service }</strong></a>
								if m.Running != "" {
									<span class="mono">{ " " + m.Running }</span>
								}
								<span class="muted">{ " · " + m.Why }</span>
							</li>
						}
					</ul>
				}
			</div>
		}
		if v.CanWatch {
			<form class="panel-body row watch-form" method="post" action="/security/watches">
				<label>What<input name="term" required maxlength="100" placeholder="php, openssl, ghcr.io/acme/api…"/></label>
				<label class="grow">Why<input name="note" maxlength="200" placeholder="e.g. the advance notice: two critical fixes on Oct 21"/></label>
				<label>
					For
					<select name="days">
						<option value="7">a week</option>
						<option value="14">two weeks</option>
						<option value="30">a month</option>
						<option value="90">three months</option>
						<option value="0">until removed</option>
					</select>
				</label>
				<button type="submit">Watch</button>
			</form>
		}
	</section>
}

// deadlinesPanel shows the remediation deadlines, what is past them, and lets an admin set them.
templ deadlinesPanel(v SecurityView) {
	<section class="panel" id="deadlines">
		<div class="panel-head">
			<h2>Remediation deadlines</h2>
			@panelInfo("How many days the workspace gives itself to upgrade away from an exploited vulnerability (from CISA listing it while it runs), a release that fixes vulnerabilities (from Goliash finding it) and a release cycle past its end of life (from that date). Updates, the security brief and the posture report mark what is due and what is past.")
		</div>
		<div class="panel-body">
			if v.Deadlines.Any() {
				<p>
					{ "Exploited vulnerability: " + deadlineLabel(v.Deadlines.Exploited) + " · security fix: " + deadlineLabel(v.Deadlines.Security) + " · end of life: " + deadlineLabel(v.Deadlines.EOL) + ". " }
					if v.Overdue > 0 {
						<a class="badge eol" href="/updates?due=over">{ plural(v.Overdue, "upgrade", "upgrades") + " past deadline" }</a>
					} else {
						<span class="badge ok">nothing past deadline</span>
					}
					if v.DueSoon > 0 {
						{ " " }<span class="badge warn">{ itoa(v.DueSoon) + " due within a week" }</span>
					}
				</p>
			} else {
				<p class="muted">No deadlines set: Updates ranks by urgency alone.</p>
			}
		</div>
		if v.CanSetDeadlines {
			<form class="panel-body row watch-form" method="post" action="/security/deadlines">
				@deadlineSelect("exploited", "Exploited vulnerability", v.Deadlines.Exploited)
				@deadlineSelect("security", "Security fix", v.Deadlines.Security)
				@deadlineSelect("eol", "End of life", v.Deadlines.EOL)
				<button type="submit">Save deadlines</button>
			</form>
		}
	</section>
}

templ deadlineSelect(name, label string, current int) {
	<label>
		{ label }
		<select name={ name }>
			for _, d := range deadlineDays {
				<option value={ itoa(d) } selected?={ d == current }>{ deadlineLabel(d) }</option>
			}
		</select>
	</label>
}

// sinceYesterday is the security brief on the page: what to look at today, each a link to where to act.
templ sinceYesterday(v SecurityView) {
	<section class="panel since-yesterday" id="since-yesterday" aria-labelledby="since-yesterday-h">
		<div class="panel-head">
			<h2 id="since-yesterday-h">Since yesterday</h2>
			@panelInfo("What to look at today, as the security brief notification sends it each morning: new releases that fix vulnerabilities in what runs, vulnerabilities CISA newly lists as exploited, upgrades past their deadline and fixes merged but not deployed.")
		</div>
		if !v.Brief.Any() {
			<p class="panel-body muted">Nothing new to look at: no security release since yesterday, nothing exploited running, no security upgrade waiting.</p>
		} else {
			<ul class="panel-body brief-list">
				for _, f := range v.Brief.Fixes {
					<li><span class="badge eol">security release</span> <a class="u" href={ templ.URL("/services/" + url.PathEscape(f.Service)) }><strong>{ f.Service }</strong></a> { f.Version + " fixes vulnerabilities; " + f.Running + " runs" }</li>
				}
				for _, cve := range v.Brief.NewKEV {
					<li><span class="badge eol">newly exploited</span> <a class="u" href={ templ.URL("/security/vulns?q=" + url.QueryEscape(cve)) }>{ cve }</a> runs, and CISA listed it as exploited in the wild</li>
				}
				if v.Brief.Exploited > 0 {
					<li>
						<a class="u" href="/security/vulns?kev=1">{ plural(v.Brief.Exploited, "vulnerability", "vulnerabilities") + " exploited in the wild" }</a> run
						if len(v.Brief.PastDue) > 0 {
							{ ", " + itoa(len(v.Brief.PastDue)) + " past CISA's due date: " + strings.Join(v.Brief.PastDue, ", ") }
						}
					</li>
				}
				if len(v.Brief.Overdue) > 0 {
					<li><a class="badge eol" href="/updates?due=over">{ plural(len(v.Brief.Overdue), "upgrade", "upgrades") + " past deadline" }</a> { overdueNames(v.Brief.Overdue, v.At) }</li>
				}
				if v.Brief.Waiting > 0 {
					<li><a class="u" href="/updates">{ plural(v.Brief.Waiting, "upgrade", "upgrades") + " fixing vulnerabilities" }</a> wait in Updates</li>
				}
				if len(v.Brief.Undeployed) > 0 {
					<li><a class="u" href="/delivery">{ plural(len(v.Brief.Undeployed), "pull request", "pull requests") + " merged" }</a> and not deployed</li>
				}
			</ul>
		}
	</section>
}

// sbomHelper lists the production images whose packages Goliash does not know, and how to give each build an SBOM.
templ sbomHelper(blind []versions.BlindImage) {
	<section class="panel" id="sbom">
		<div class="panel-head">
			<h2>{ plural(len(blind), "image without an SBOM", "images without an SBOM") }</h2>
			@panelInfo("Their vulnerabilities are unknown: Goliash reads a vulnerability list from an image's SBOM, or else from its dpkg or apk package database. Add an SBOM to the build and Goliash reads it from the registry at the next deploy.")
		</div>
		<div class="scroll" tabindex="0">
			<table class="cards">
				<thead><tr><th>Image</th><th>Service</th><th>Why</th><th>Add an SBOM</th></tr></thead>
				<tbody>
					for i, b := range blind {
						if i < blindShown {
							<tr>
								<td data-label="Image"><code>{ b.Image }</code></td>
								<td data-label="Service"><a href={ templ.URL(serviceURL(b.Service)) }>{ b.Service }</a></td>
								<td data-label="Why" class="muted">{ b.Why }</td>
								<td data-label="Add an SBOM"><a href={ templ.URL("#sbom-" + sbomHow(b.Source)) }>{ sbomHowLabel(sbomHow(b.Source)) }</a></td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
		if len(blind) > blindShown {
			<p class="panel-body muted">{ "and " + itoa(len(blind)-blindShown) + " more" }</p>
		}
		<div class="panel-body stack">
			<details class="install" id="sbom-github">
				<summary>GitHub Actions</summary>
				<pre class="mono" id="sbom-github-snippet">{ sbomGitHub }</pre>
				<button type="button" class="secondary" data-copy="sbom-github-snippet">Copy</button>
			</details>
			<details class="install" id="sbom-gitlab">
				<summary>GitLab CI</summary>
				<pre class="mono" id="sbom-gitlab-snippet">{ sbomGitLab }</pre>
				<button type="button" class="secondary" data-copy="sbom-gitlab-snippet">Copy</button>
			</details>
			<details class="install" id="sbom-buildx">
				<summary>docker buildx, anywhere</summary>
				<pre class="mono" id="sbom-buildx-snippet">{ sbomBuildx }</pre>
				<button type="button" class="secondary" data-copy="sbom-buildx-snippet">Copy</button>
			</details>
			<details class="install" id="sbom-existing">
				<summary>An image already pushed, without rebuilding</summary>
				<pre class="mono" id="sbom-existing-snippet">{ sbomExisting }</pre>
				<button type="button" class="secondary" data-copy="sbom-existing-snippet">Copy</button>
			</details>
			<p class="muted">Software built from source or copied into the image is in no package database: declare it in the Dockerfile, <code>LABEL dev.goliash.components="nginx=1.27.2, php=8.3.12"</code>, and Goliash looks up its CVEs by version. See <a href="https://goliash.dev/guide/security/#images-without-an-sbom" target="_blank" rel="noopener">the guide</a>.</p>
		</div>
	</section>
}

// patchChart draws production's time to patch month by month: how many days after the first newer release the
// upgrades were deployed, the median and the 90th percentile.
templ patchChart(v SecurityView) {
	{{ most := mostDays(v.PatchMonths) }}
	<section class="panel" id="time-to-patch">
		<div class="panel-head">
			<h2>{ "Time to patch in " + v.Prod.Name }</h2>
			@panelInfo("For each upgrade deployed to production: the days from the first release after the version it replaced to the deploy. Bars are the month's median, the lighter part its 90th percentile.")
		</div>
		<div class="panel-body patch-chart" role="img" aria-label={ "Time to patch in " + v.Prod.Name + ", median days per month" }>
			for _, m := range v.PatchMonths {
				<div class="patch-month" title={ m.Month.Format("January 2006") + ": " + plural(m.Upgrades, "upgrade", "upgrades") + ", median " + days(m.Median) + ", 90th percentile " + days(m.P90) }>
					<div class="patch-bars">
						<span class="patch-p90" style={ "height:" + itoa(monthBar(m.P90, most)) + "%" }></span>
						<span class="patch-median" style={ "height:" + itoa(monthBar(m.Median, most)) + "%" }></span>
					</div>
					<strong>
						if m.Upgrades > 0 {
							{ itoa(m.Median) }<span class="unit">{ " " + dayWord(m.Median) }</span>
						} else {
							—
						}
					</strong>
					<small>{ m.Month.Format("Jan") + " · " + itoa(m.Upgrades) }</small>
				</div>
			}
		</div>
	</section>
}

// teamsPanel sums production up per team, slowest first.
templ teamsPanel(v SecurityView) {
	<section class="panel" id="teams">
		<div class="panel-head">
			<h2>Patching by team</h2>
			@panelInfo("Each service's owner is its team. Behind: production services with a newer release, and the median days they have been behind. Time to patch: the median days the team's upgrades deployed in the last 90 days had been behind. The bars are the last six months' medians.")
		</div>
		<div class="scroll" tabindex="0">
			<table class="cards">
				<thead><tr><th>Team</th><th class="num">In prod</th><th class="num">Behind</th><th class="num">Past deadline</th><th class="num">Patched (90 days)</th><th>Time to patch</th></tr></thead>
				<tbody>
					for _, t := range v.Teams {
						<tr>
							<td data-label="Team"><a href={ templ.URL("/updates?team=" + url.QueryEscape(t.Owner)) }><strong>{ teamName(t.Owner) }</strong></a></td>
							<td class="num" data-label="In prod">{ itoa(t.Services) }</td>
							<td class="num" data-label="Behind">
								{ itoa(t.Behind) }
								if t.Behind > 0 {
									<small class="muted">{ " · " + days(t.MedianBehind) }</small>
								}
							</td>
							<td class="num" data-label="Past deadline">
								if t.Overdue > 0 {
									<a class="badge eol" href={ templ.URL("/updates?due=over&team=" + url.QueryEscape(t.Owner)) }>{ itoa(t.Overdue) }</a>
								} else {
									0
								}
							</td>
							<td class="num" data-label="Patched">{ itoa(t.Patched) }</td>
							<td data-label="Time to patch">
								<span class="team-patch">
									<span class="team-bars" aria-hidden="true">
										{{ top := teamMost(t) }}
										for _, d := range t.Monthly {
											<span class={ "team-bar", templ.KV("none", d < 0) } style={ "height:" + itoa(monthBar(d, top)) + "%" }></span>
										}
									</span>
									if t.Patched > 0 {
										{ days(t.MedianPatch) }
									} else {
										<span class="muted">no upgrade</span>
									}
								</span>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
}

// securityNav jumps to the page's sections, each with what stands out in it.
templ securityNav(v SecurityView) {
	<nav class="page-nav noprint" aria-label="On this page">
		for _, l := range securityLinks(v) {
			<a href={ templ.URL("#" + l.ID) } class={ templ.KV("warn", l.Warn) }>
				{ l.Label }
				if l.Note != "" {
					<small>{ l.Note }</small>
				}
			</a>
		}
	</nav>
}
