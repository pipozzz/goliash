package ui

// ErrorPage explains a 403, 404 or 500 and offers a way on.
templ ErrorPage(v ErrorView) {
	<!DOCTYPE html>
	<html lang="en">
		@head(v.Title)
		<body>
			<div class="login">
				<div class="card">
					<a class="brand" href="/">
						@logo()
						Goliash
					</a>
					<div>
						<p class="muted mono">{ itoa(v.Status) }</p>
						<h1>{ v.Title }</h1>
					</div>
					<p>{ v.Message }</p>
					<div class="actions">
						<a class="button" href="/">Go to the matrix</a>
						if !v.SignedIn {
							<a class="button secondary" href="/login">Sign in</a>
						}
					</div>
				</div>
			</div>
		</body>
	</html>
}

templ errorLine(msg string) {
	<div class="empty" role="alert"><p>{ msg }</p></div>
}
