package ui

templ GitOpsPage(v GitOpsPageView) {
	@Layout(v.Base) {
		<div class="head">
			<div>
				<h1>GitOps applications</h1>
				@aboutText("Every Argo CD application and Flux Kustomization that deploys a service, on every cluster: what Git declares and whether it runs, those degraded, missing or out of sync first. Upgrades and rollbacks open as pull requests from here.")
			</div>
			if v.Total > 0 {
				@pageFilter("main table tbody tr", "Filter applications, services, versions")
			}
		</div>
		if v.Total == 0 {
			<section class="panel">
				<div class="empty">No Argo CD application or Flux Kustomization deploys a mapped workload yet. <a href="https://goliash.dev/guide/argocd/" target="_blank" rel="noopener">How Goliash reads them</a></div>
			</section>
		} else {
			<section class="panel">
				<div class="report-stats">
					<div><strong>{ itoa(v.Total) }</strong><span>deployed workloads</span></div>
					<div><strong>{ itoa(v.Unhealthy) }</strong><span>degraded or missing</span></div>
					<div><strong>{ itoa(v.OutOfSync) }</strong><span>out of sync</span></div>
				</div>
			</section>
			<nav class="segmented" aria-label="Show">
				<span class="muted">Show</span>
				<a href="/gitops" class={ templ.KV("on", !v.Only) }>All</a>
				<a href="/gitops?only=attention" class={ templ.KV("on", v.Only) }>Needs attention</a>
			</nav>
			if len(v.Apps) == 0 {
				<section class="panel"><div class="empty">Every application is in sync and healthy.</div></section>
			} else {
				@gitOpsPanel(v.Apps, v.CanEdit, true)
			}
		}
	}
}

// prChecks is what a pull request's checks say, next to its link: nothing when it runs none.
templ prChecks(checks string) {
	switch checks {
		case "passing":
			<span class="badge ok pr-checks" title="Its checks (CI) pass">checks pass</span>
		case "failing":
			<span class="badge eol pr-checks" title="Its checks (CI) fail: look before merging">checks fail</span>
		case "pending":
			<span class="badge neutral pr-checks" title="Its checks (CI) are running">checks running</span>
	}
}
