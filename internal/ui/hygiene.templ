package ui

import (
	"strings"

	"github.com/pipozzz/goliash/internal/versions"
)

templ HygienePage(v HygieneView) {
	@Layout(v.Base) {
		<div class="head">
			<div>
				<h1>Image hygiene</h1>
				<p class="sub">Images that make "what runs" hard to know or to trust: moving tags, tags pushed again, registries outside the allowed list, and images without a known digest.</p>
			</div>
		</div>
		if v.Total > 0 {
			<nav class="tiles" aria-label="Kinds of findings">
				<a href="/hygiene" class={ "tile", templ.KV("current", v.Kind == "") }>
					<strong>{ itoa(v.Total) }</strong>
					<span>All findings</span>
				</a>
				for _, k := range v.Kinds {
					<a href={ templ.URL("/hygiene?kind=" + k.Kind) } class={ "tile", templ.KV("current", v.Kind == k.Kind), templ.KV("warn", k.Warn && k.Count > 0), templ.KV("zero", k.Count == 0) }>
						<strong>{ itoa(k.Count) }</strong>
						<span>{ k.Label }</span>
						<small>{ k.Help }</small>
					</a>
				}
			</nav>
		}
		if len(v.DigestHints) > 0 {
			<section class="panel">
				<div class="panel-head"><h2>Why digests are unknown</h2><span class="muted">these targets report none at all</span></div>
				<div class="scroll">
					<table>
						<thead><tr><th>Target</th><th>Images</th><th>What to do</th></tr></thead>
						<tbody>
							for _, h := range v.DigestHints {
								<tr>
									<td><strong>{ h.Target }</strong><div class="targets">{ h.Platform }</div></td>
									<td class="num">{ itoa(h.Images) }</td>
									<td>{ h.Advice }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		}
		<section class="panel">
			if len(v.Findings) == 0 && v.Total > 0 {
				<div class="empty">None of this kind. <a href="/hygiene">Show all findings</a></div>
			} else if len(v.Findings) == 0 {
				<div class="empty">Nothing found: every image has a version tag and a known digest.</div>
			} else {
				<div class="scroll">
					<table>
						<thead><tr><th>Image</th><th>Problem</th><th>Where</th></tr></thead>
						<tbody>
							for _, f := range v.Findings {
								<tr>
									<td class="mono">{ f.Image }</td>
									<td>
										<span class={ "badge", findingClass(f) }>{ findingLabel(f.Kind) }</span>
										<div class="targets">{ f.Detail }</div>
										if v.Goli {
											<button type="button" class="link ask-goli noprint" data-goli-ask={ explainFinding(f) } title="Goli explains the risk and how to fix it here">Explain</button>
										}
									</td>
									<td>
										for _, w := range f.Where {
											<div class="targets">{ w }</div>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
	}
}

func findingClass(f versions.Finding) string {
	if f.Severity == "warning" {
		return "env"
	}
	return "neutral"
}

// findingLabel is a finding's kind as people read it.
func findingLabel(kind string) string {
	if kind == "unpinned" {
		return "digest unknown"
	}
	return strings.ReplaceAll(kind, "-", " ")
}

// explainFinding is what the Explain button asks Goli about an image hygiene finding.
func explainFinding(f versions.Finding) string {
	where := ""
	if len(f.Where) > 0 {
		where = " It runs at " + f.Where[0]
		if len(f.Where) > 1 {
			where += " and " + itoa(len(f.Where)-1) + " more places"
		}
		where += "."
	}
	return "Explain this image hygiene finding: " + f.Image + " is flagged " + findingLabel(f.Kind) + " (" + f.Detail + ")." + where +
		" Why is it a risk, and how do we fix it in the deployment, step by step?"
}
