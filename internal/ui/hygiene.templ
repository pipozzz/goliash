package ui

import (
	"strings"

	"github.com/pipozzz/goliash/internal/versions"
)

templ HygienePage(v HygieneView) {
	@Layout(v.Base) {
		<div class="head">
			<div>
				<h1>Image hygiene</h1>
				<p class="sub">Images that make "what runs" hard to know or to trust: moving tags, tags pushed again, registries outside the allowed list, and images without a known digest.</p>
			</div>
		</div>
		if v.Total > 0 {
			<nav class="tiles" aria-label="Kinds of findings">
				<a href="/hygiene" class={ "tile", templ.KV("current", v.Kind == "") }>
					<strong>{ itoa(v.Total) }</strong>
					<span>All findings</span>
				</a>
				for _, k := range v.Kinds {
					<a href={ templ.URL("/hygiene?kind=" + k.Kind) } class={ "tile", templ.KV("current", v.Kind == k.Kind), templ.KV("warn", k.Warn && k.Count > 0), templ.KV("zero", k.Count == 0) }>
						<strong>{ itoa(k.Count) }</strong>
						<span>{ k.Label }</span>
						<small>{ k.Help }</small>
					</a>
				}
			</nav>
		}
		<section class="panel">
			if len(v.Findings) == 0 && v.Total > 0 {
				<div class="empty">None of this kind. <a href="/hygiene">Show all findings</a></div>
			} else if len(v.Findings) == 0 {
				<div class="empty">Nothing found: every image has a version tag and a known digest.</div>
			} else {
				<div class="scroll">
					<table>
						<thead><tr><th>Image</th><th>Problem</th><th>Where</th></tr></thead>
						<tbody>
							for _, f := range v.Findings {
								<tr>
									<td class="mono">{ f.Image }</td>
									<td>
										<span class={ "badge", findingClass(f) }>{ strings.ReplaceAll(f.Kind, "-", " ") }</span>
										<div class="targets">{ f.Detail }</div>
									</td>
									<td>
										for _, w := range f.Where {
											<div class="targets">{ w }</div>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
	}
}

func findingClass(f versions.Finding) string {
	if f.Severity == "warning" {
		return "env"
	}
	return "neutral"
}
