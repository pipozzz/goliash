package ui

templ logo() {
	<svg width="22" height="22" viewBox="0 0 96 96" aria-hidden="true">
		<rect width="96" height="96" rx="22" fill="#1b2a6b"></rect>
		<g transform="translate(17 17)" fill="#8aa4ff">
			<rect x="0" y="0" width="18" height="18" rx="4.5"></rect>
			<rect x="22" y="0" width="18" height="18" rx="4.5" opacity=".55"></rect>
			<rect x="44" y="0" width="18" height="18" rx="4.5" opacity=".3"></rect>
			<rect x="0" y="22" width="18" height="18" rx="4.5" opacity=".55"></rect>
			<rect x="22" y="22" width="18" height="18" rx="4.5"></rect>
			<rect x="44" y="22" width="18" height="18" rx="4.5" fill="#ffb347"></rect>
			<rect x="0" y="44" width="18" height="18" rx="4.5" opacity=".3"></rect>
			<rect x="22" y="44" width="18" height="18" rx="4.5" opacity=".55"></rect>
			<rect x="44" y="44" width="18" height="18" rx="4.5"></rect>
		</g>
	</svg>
}

templ head(title string) {
	@headIcon(title, asset("logo.svg"))
}

// headIcon is head with a favicon of its own: signed-in pages use the live one, the
// logo coloured by the workspace's state.
templ headIcon(title, icon string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<meta name="color-scheme" content="light dark"/>
		<meta name="referrer" content="same-origin"/>
		<!-- Show error pages (403, 404, 500) instead of ignoring them, so a failed action says why. -->
		<meta name="htmx-config" content={ htmxConfig }/>
		<title>{ title } · Goliash</title>
		<link rel="stylesheet" href={ templ.URL(asset("app.css")) }/>
		<link rel="icon" type="image/svg+xml" href={ templ.URL(icon) } id="favicon"/>
		<!-- Installable (and on iPhone, web push needs Goliash added to the home screen). -->
		<link rel="manifest" href="/manifest.webmanifest"/>
		<link rel="apple-touch-icon" href="/static/icon-192.png"/>
		<meta name="theme-color" content="#1b2a6b"/>
	</head>
}

templ menuLink(b Base, page, href, label string) {
	<a
		href={ templ.URL(href) }
		class="menu-item"
		role="menuitem"
		if b.Page == page {
			aria-current="page"
		}
	>{ label }</a>
}

templ gear() {
	<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="12" cy="12" r="3"></circle>
		<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
	</svg>
}

templ navLink(b Base, page, href, label string) {
	<a
		href={ templ.URL(href) }
		if b.Page == page {
			aria-current="page"
		}
	>
		{ label }
		if page == "inbox" && b.InboxCount > 0 {
			<span class="count">{ itoa(b.InboxCount) }</span>
		}
	</a>
}

templ Layout(b Base) {
	<!DOCTYPE html>
	<html lang="en">
		if b.Email != "" {
			@headIcon(b.Title, "/ui/favicon.svg")
		} else {
			@head(b.Title)
		}
		<body hx-boost="true" class={ templ.KV("kiosk", b.Kiosk) }>
			if !b.Kiosk {
				<header class="top">
					<div class="top-inner">
						<a class="brand" href="/">
							@logo()
							Goliash
						</a>
						<nav class="nav" aria-label="Main">
							@navLink(b, "matrix", "/", "Matrix")
							@navLink(b, "inbox", "/inbox", "Inbox")
							@navLink(b, "updates", "/updates", "Updates")
							@navLink(b, "promotions", "/delivery", "Delivery")
							@navLink(b, "events", "/events", "History")
							@navLink(b, "hygiene", "/hygiene", "Hygiene")
						</nav>
						<button type="button" class="palette-open" data-palette aria-keyshortcuts="Control+K Meta+K" title="Search (Ctrl+K)">
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
							<span>Search</span>
							<kbd>⌘K</kbd>
						</button>
						<div class="who">
							if len(b.Workspaces) > 1 {
								<form method="post" action="/workspace" hx-boost="false" class="switcher">
									<select name="workspace" aria-label="Workspace" data-autosubmit>
										for _, w := range b.Workspaces {
											<option value={ w.ID } selected?={ w.Current }>{ w.Name }</option>
										}
									</select>
									<noscript><button type="submit" class="secondary">Open</button></noscript>
								</form>
							} else if b.Workspace != "" {
								<span class="ws-name">{ b.Workspace }</span>
							}
							<details class="menu">
								<summary class={ templ.KV("current", isSettings(b.Page)) }>
									@gear()
									<span class="menu-label">Settings</span>
								</summary>
								<div class="menu-list" role="menu">
									@menuLink(b, "apps", "/apps", "Applications")
									@menuLink(b, "teams", "/teams", "Teams")
									@menuLink(b, "agents", "/agents", "Agents and targets")
									@menuLink(b, "notifications", "/notifications", "Notifications")
									if b.CanAdmin {
										@menuLink(b, "settings", "/settings", "Users and API tokens")
									}
									if b.OrgAdmin {
										@menuLink(b, "workspaces", "/workspaces", "Workspaces")
									}
								</div>
							</details>
							<details class="menu">
								<summary class={ templ.KV("current", b.Page == "account") } title={ b.Email + " · " + b.Role }>
									<span class="avatar" aria-hidden="true">{ initial(b.Email) }</span>
									<span class="menu-label who-email">{ b.Email }</span>
								</summary>
								<div class="menu-list" role="menu">
									<div class="menu-head">
										<strong>{ b.Email }</strong>
										<span class="muted">{ b.Role }</span>
									</div>
									@menuLink(b, "account", "/account", "Your account")
									<form method="post" action="/auth/logout" hx-boost="false">
										<button class="menu-item" type="submit" role="menuitem">Sign out</button>
									</form>
								</div>
							</details>
						</div>
					</div>
				</header>
			}
			<main>
				if b.Notice != "" {
					<div class="notice" role="status">{ b.Notice }</div>
				}
				if b.Error != "" {
					<div class="notice error" role="alert">{ b.Error }</div>
				}
				{ children... }
			</main>
			<script src={ templ.URL(asset("htmx.min.js")) }></script>
			<script src={ templ.URL(asset("app.js")) }></script>
		</body>
	</html>
}

templ Login(v LoginView) {
	<!DOCTYPE html>
	<html lang="en">
		@head("Sign in")
		<body>
			<div class="login">
				<div class="card">
					<span class="brand">
						@logo()
						Goliash
					</span>
					<div>
						<h1>Sign in</h1>
						<p class="muted">What runs where, on which version.</p>
					</div>
					if v.NoAccounts {
						<div class="notice" role="status">
							<strong>Nobody has an account yet.</strong> The server wrote a link to create the first one into its log, e.g.
							<code>docker compose logs goliash | grep link=</code>
						</div>
					}
					if v.Sent {
						<div class="notice" role="status">If that address has an account, a sign-in link is on its way. It works once and expires in 15 minutes.</div>
					}
					if v.Error != "" {
						<div class="notice error" role="alert">{ v.Error }</div>
					}
					if v.OIDC != "" {
						<a class="button" href="/auth/oidc/start" style="justify-content:center">Continue with { v.OIDC }</a>
					}
					if v.Passkeys && !v.NoAccounts {
						<button type="button" class={ "passkey-button", templ.KV("secondary", v.OIDC != "") } data-passkey="/auth/passkey" hidden>Sign in with a passkey</button>
						<p class="notice error" data-passkey-error hidden role="alert"></p>
					}
					if v.Password {
						if v.OIDC != "" {
							<div class="divider">or</div>
						}
						<form class="stack" method="post" action="/auth/password">
							<label>
								E-mail
								<input id="email" type="email" name="email" required autocomplete="username webauthn" autofocus?={ v.OIDC == "" }/>
							</label>
							<label>
								Password
								<input type="password" name="password" required autocomplete="current-password"/>
							</label>
							<button type="submit">Sign in</button>
							if v.Mail {
								<a class="forgot" href="#link-email">Forgot your password?</a>
							}
						</form>
					}
					if v.Mail {
						if v.OIDC != "" || v.Password {
							<div class="divider">
								if v.Password {
									forgot your password or have none?
								} else {
									or
								}
							</div>
						}
						<form class="stack" method="post" action="/auth/magic">
							<label>
								E-mail
								<input id="link-email" type="email" name="email" required autocomplete="email" autofocus?={ v.OIDC == "" && !v.Password }/>
							</label>
							<button type="submit" class={ templ.KV("secondary", v.Password) }>E-mail me a sign-in link</button>
							if v.Password {
								<p class="hint">After signing in with it, set a new password under your account within 15 minutes, without the old one.</p>
							}
						</form>
					}
					if !v.Mail && !v.NoAccounts {
						<p class="muted">
							if v.Password {
								No password yet, or forgot it?
							}
							Ask an administrator for a sign-in link: they create one under Settings → People. With it you
							set a new password under your account. On the server, <code>goliash login-link -email you@example.com</code>
							prints one too.
						</p>
					}
				</div>
			</div>
			if v.Passkeys {
				<script src={ templ.URL(asset("passkey.js")) }></script>
			}
		</body>
	</html>
}
