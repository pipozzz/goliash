package ui

import "strings"

templ MatrixPage(v MatrixView) {
	@Layout(v.Base) {
		<div class="head">
			<div>
				<h1>Service × environment</h1>
				<p class="sub" data-tl-asof hidden?={ v.At == "" }>As of <strong data-tl-asof-date>{ strings.Replace(v.At, "T", " ", 1) } UTC</strong>: what ran then, against the newest releases out by then, with drift as it was. <a href="/">Back to now</a></p>
				<div data-tl-live hidden?={ v.At != "" }>@aboutText("What runs where, the newest release upstream, and where versions drift apart.")</div>
			</div>
			if v.At == "" && len(v.Grid.Rows) > 0 {
				<div class="legend" data-tl-live>
					<span class="badge exploited">exploited vulnerability</span>
					<span class="badge env">behind previous env</span>
					<span class="badge upstream">upstream newer</span>
					<span class="badge inconsistent">targets disagree</span>
					<span class="badge declared">differs from Git</span>
					<a class="live off" data-live href="/status" title="Live updates; Goliash's own status">Connecting…</a>
				</div>
			}
		</div>
		if v.At == "" && len(v.Grid.Rows) > 0 {
			@viewTabsBar(v.Views)
		}
		if v.At != "" || len(v.Grid.Rows) > 0 {
			<div class="toolbar">
				if len(v.Grid.Rows) > 0 && v.At == "" {
					<nav class="segmented" aria-label="View">
						<span class="muted">View</span>
						<a href={ templ.URL("/?view=table&group=" + v.Grid.GroupBy) } class="on" aria-current="page">Table</a>
						<a href={ templ.URL("/tiles?group=" + tileGroup(v.Grid.GroupBy)) } title="Every application as a cell, coloured like the logo">Tiles</a>
					</nav>
				}
				if len(v.Grid.Rows) > 0 {
					<nav class="segmented" aria-label="Group by">
						<span class="muted">Group by</span>
						for _, m := range matrixGroupModes {
							if v.Grid.GroupBy == m.Key {
								<a href={ templ.URL(matrixURL(m.Key, v.At)) } class="on" aria-current="page">{ m.Label }</a>
							} else {
								<a href={ templ.URL(matrixURL(m.Key, v.At)) }>{ m.Label }</a>
							}
						}
					</nav>
				}
				if v.At == "" && len(v.Grid.Rows) > 0 {
					<input type="search" id="matrix-q" class="search" placeholder="Filter services, owners, versions" aria-label="Filter services" aria-keyshortcuts="/" autocomplete="off"/>
					<label class="check"><input type="checkbox" id="matrix-drift"/> Only with drift</label>
					@kindFilter(kindOptions(v.Grid.Rows), "matrix-q")
					<span class="muted" id="matrix-count" aria-live="polite"></span>
				}
				<span class="spacer"></span>
				if v.Hygiene > 0 {
					<a href="/hygiene" class="toolbar-link">
						Image hygiene <span class="count">{ itoa(v.Hygiene) }</span>
					</a>
				}
				if v.CanMember {
					<a href="/services/new" class="toolbar-link" title="Software Goliash does not collect: a VM, a managed service">Add by hand</a>
				}
				<a href={ templ.URL(exportURL(v.At)) } hx-boost="false" class="toolbar-link">Export CSV</a>
				<a href={ templ.URL(exportFormatURL("cyclonedx", v.At)) } hx-boost="false" class="toolbar-link" title="CycloneDX 1.6 BOM of what runs, with the packages of each image's SBOM: for Dependency-Track or an auditor">SBOM</a>
				if v.At == "" {
					<a href={ templ.URL(matrixURL(v.Grid.GroupBy, v.Yesterday)) } class="toolbar-link timetravel-open" data-tl-open hx-boost="false" title="Scrub through what ran when, deployment by deployment">Time travel</a>
				}
			</div>
			@timeTravel(newTimeTravel("matrix", matrixURL(v.Grid.GroupBy, ""), v.Grid.GroupBy, v.At))
		}
		if v.At != "" {
			<section class="panel" id="matrix-panel">
				@MatrixGridView(v.Grid)
			</section>
		} else {
			<section
				id="matrix-panel"
				class="panel"
				hx-get={ "/ui/matrix?group=" + v.Grid.GroupBy }
				hx-trigger="goliash:changed from:body, every 60s"
				hx-swap="innerHTML"
				aria-live="polite"
			>
				@MatrixGridView(v.Grid)
			</section>
		}
	}
}

templ MatrixGridView(g MatrixGrid) {
	if len(g.Unread) > 0 && len(g.Rows) > 0 {
		<div class="unread-hint" role="status">
			for _, u := range g.Unread {
				<p>
					<strong>{ plural(u.Services, "service", "services") } on <code>{ u.Host }</code></strong>
					if u.Managed {
						<span class="muted">show no newest release yet: the agent that watches them asks AWS which versions it offers. Update that agent, and let its role call the Describe…EngineVersions actions (the policy on the agent's <strong>Add AWS</strong> page has them).</span>
					} else {
						<span class="muted">show no newest release: no agent could read this private registry yet.</span>
					}
					if u.Error != "" {
						<span class="muted unread-error" title={ u.Error }>{ "The agent's last answer: " + shortError(u.Error) }</span>
					}
					if u.Managed {
					} else if u.ECR {
						<span class="muted">Give the agent's IAM role <code>ecr:ListImages</code> (or AmazonEC2ContainerRegistryReadOnly).</span>
						<a class="link" href="https://goliash.dev/reference/collectors/#private-registries" target="_blank" rel="noopener">How</a>
					} else if g.CanAdmin {
						<a class="link" href={ templ.URL("/settings?registry=" + u.Host + "#registries") }>Give the server read access</a>
					} else {
						<span class="muted">An admin can give the server read access under Settings.</span>
					}
				</p>
			}
		</div>
	}
	if len(g.Rows) == 0 && g.Past {
		<p class="empty-past muted">Nothing Goliash knows of ran then: no target had reported yet, or nothing ran.</p>
	} else if len(g.Rows) == 0 {
		@firstRun(g.Steps, g.Explore)
	} else {
		<div class="scroll" tabindex="0">
			<table class="matrix">
				<thead>
					<tr>
						<th>Service</th>
						for _, e := range g.Envs {
							<th class="env">
								{ e.Name }
								<small>{ plural(e.Targets, "target", "targets") }</small>
							</th>
						}
						<th>Latest upstream</th>
					</tr>
				</thead>
				for _, grp := range g.Groups {
					<tbody class={ "mgroup", templ.KV("named", grp.Name != "") }>
						if grp.Name != "" {
							<tr class="group-head">
								<th colspan={ itoa(len(g.Envs) + 2) } scope="rowgroup">
									<div class="group-line">
										if g.GroupBy == "app" || g.GroupBy == "team" {
											<span class={ "app-avatar", versionColour(grp.Name) } aria-hidden="true">{ initial(grp.Name) }</span>
										} else if g.GroupBy == "kind" {
											@kindIcons([]string{kindGroupIcon(grp.Name)})
										}
										if grp.URL != "" {
											<a class="group-name" href={ templ.URL(grp.URL) } title={ "The target page of " + grp.Name }>{ grp.Name }</a>
										} else {
											<span class="group-name">{ grp.Name }</span>
										}
										<span class="count-pill">{ itoa(len(grp.Rows)) }</span>
										if grp.Caption != "" {
											<small>{ grp.Caption }</small>
										}
										if g.GroupBy != "status" {
											@groupHealth(grp)
										}
									</div>
								</th>
							</tr>
						}
						for _, r := range grp.Rows {
							<tr
								data-search={ rowSearch(r) }
								data-drift={ rowDrift(r) }
								data-health={ r.Health }
								if r.Same != "" {
									data-same={ r.Same }
								}
							>
								<td class="svc">
									@kindIcons(r.Kinds)
									<a href={ templ.URL(r.URL) }>{ r.Service }</a>
									if r.Split && g.GroupBy != "app" {
										<span class="part" title="Used by several applications: versions are compared within each">{ "in " + orOther(r.App) }</span>
									}
									if r.What != "" {
										<span class="what">{ r.What }</span>
									}
									if r.Owner != "" {
										<span class="owner">{ r.Owner }</span>
									}
									if r.Same != "" {
										<button type="button" class="link same-more" data-same-more hidden></button>
									}
								</td>
								for i, c := range r.Cells {
									<td data-label={ envLabel(g.Envs, i) } data-key={ r.Service + "|" + r.App + "|" + envLabel(g.Envs, i) }>
										@cellView(c)
									</td>
								}
								<td class="latest" data-label="Upstream">
									if r.Latest != "" && r.LatestURL != "" {
										<a class="tag" href={ templ.URL(r.LatestURL) } target="_blank" rel="noopener noreferrer" title="Release notes">{ r.Latest }</a>
									} else if r.Latest != "" {
										<span class="tag">{ r.Latest }</span>
									} else {
										<span class="none">—</span>
									}
									if r.Note != "" {
										<div class="targets" title={ r.NoteTitle }>{ r.Note }</div>
									}
								</td>
							</tr>
						}
					</tbody>
				}
			</table>
		</div>
		if g.Unmapped > 0 {
			<div class="panel-head" style="border-top:1px solid var(--line);border-bottom:0">
				<span class="muted">{ plural(g.Unmapped, "workload is", "workloads are") } not mapped to a service.</span>
				<a href="/inbox">Open inbox →</a>
			</div>
		}
	}
}

// groupHealth is a group's share of current services, as a stacked bar.
templ groupHealth(grp MatrixGroup) {
	{{ ok, warn, bad := grp.healthBar(96) }}
	<span class="group-health" title={ itoa(grp.OK) + " up to date, " + itoa(grp.Warn) + " behind, " + itoa(grp.Bad) + " need attention" }>
		<svg width="96" height="6" viewBox="0 0 96 6" aria-hidden="true">
			<rect class="hb-bg" width="96" height="6" rx="3"></rect>
			<rect class="hb-ok" width={ f(ok) } height="6"></rect>
			<rect class="hb-warn" x={ f(ok) } width={ f(warn) } height="6"></rect>
			<rect class="hb-bad" x={ f(ok + warn) } width={ f(bad) } height="6"></rect>
		</svg>
		<span>{ itoa(grp.OK) + " of " + itoa(len(grp.Rows)) + " current" }</span>
	</span>
}

// resolvedTag shows the exact release behind a moving tag ("1 = 1.27.3").
templ resolvedTag(tag, resolved string) {
	if resolved != "" {
		<span class="resolved" title={ tag + " is a moving tag; the image that runs is " + resolved + " (same digest)" }>= { resolved }</span>
	}
}

templ cellView(c MatrixCell) {
	if len(c.Versions) == 0 {
		<span class="none">—</span>
	} else {
		<div class="cell">
			for _, v := range c.Versions {
				<div class="ver">
					<span class="tag">{ v.Tag }</span>
					@resolvedTag(v.Tag, v.Resolved)
					<span class="reps">× { itoa(v.Running) }</span>
				</div>
				if v.Targets != "" {
					<div class="targets">{ v.Targets }</div>
				}
			}
			if len(c.Drifts) > 0 || c.StaleTitle != "" || c.FromDeclared {
				<div class="badges">
					if c.FromDeclared {
						<span class="badge declared-only" title="Declared in Compose files; nothing reports what actually runs here.">declared</span>
					}
					for _, d := range c.Drifts {
						<span class={ "badge", d.Kind } title={ d.Title }>{ d.Label }</span>
					}
					if c.StaleTitle != "" {
						<span class="badge stale" title={ c.StaleTitle }>stale data</span>
					}
				</div>
			}
			for _, pr := range c.PRs {
				if pr.Open {
					<a class="cell-pr" href={ templ.SafeURL(pr.URL) } target="_blank" rel="noopener" title={ pr.Title }>{ pr.Label }</a>
				} else {
					<a class="cell-pr offer noprint" href={ templ.URL(pr.URL) } title={ pr.Title }>{ pr.Label }</a>
				}
			}
		</div>
	}
}

templ firstRun(steps []Step, explore bool) {
	<div class="first-run">
		<h2>Get started</h2>
		<p class="muted">The matrix fills in once a target reports and its workloads belong to services.</p>
		<ol class="steps">
			for _, st := range steps {
				<li class={ templ.KV("done", st.Done), templ.KV("next", st.Next) }>
					<span class="step-mark" aria-hidden="true"></span>
					<div>
						<strong>{ st.Title }</strong>
						if st.Optional {
							<span class="muted">optional</span>
						}
						if st.Done {
							<span class="sr-only">(done)</span>
						}
						<p class="muted">{ st.Text }</p>
					</div>
					if !st.Done {
						<a class={ "button", templ.KV("secondary", !st.Next) } href={ templ.URL(st.Href) }>{ st.Action }</a>
					}
				</li>
			}
		</ol>
		if explore {
			<form class="explore" method="post" action="/workspaces/example" data-busy="Filling it with example data…">
				<div>
					<strong>Just looking?</strong>
					<span class="muted">Open an Example workspace with three weeks of made-up data; yours stays as it is.</span>
				</div>
				<button type="submit" class="secondary">Explore with example data</button>
			</form>
		} else {
			<p class="hint">Just looking? An organization admin can open an Example workspace with three weeks of example data.</p>
		}
	</div>
}

// timeTravel is the time travel bar: a track of the past with a mark for every deployment, to scrub, step from
// change to change or play back. Without JavaScript its form picks a moment.
templ timeTravel(t TimeTravel) {
	<section class="timeline panel" id="timeline" data-kind={ t.Kind } data-base={ t.Base } data-group={ t.Group } data-at={ t.At } hidden?={ t.At == "" } aria-label="Time travel">
		<div class="tl-head">
			<div class="tl-when">
				<span class="tl-kicker">Time travel</span>
				<strong class="tl-date" data-tl-label aria-live="polite">
					if t.At != "" {
						{ strings.Replace(t.At, "T", " ", 1) } UTC
					} else {
						Now
					}
				</strong>
				<span class="muted" data-tl-note></span>
			</div>
			<div class="tl-presets" data-tl-presets hidden>
				<button type="button" class="chip" data-tl-jump="-86400">1 day ago</button>
				<button type="button" class="chip" data-tl-jump="-604800">1 week ago</button>
				<button type="button" class="chip" data-tl-jump="-2592000">30 days ago</button>
				<button type="button" class="chip" data-tl-jump="-7776000">90 days ago</button>
			</div>
			<a href={ templ.URL(t.Base) } class="button secondary tl-now" data-tl-now>Back to now</a>
		</div>
		<div class="tl-track" data-tl-track hidden>
			<svg class="tl-ticks" data-tl-ticks viewBox="0 0 1000 28" preserveAspectRatio="none" aria-hidden="true"></svg>
			<input type="range" class="tl-range" data-tl-range min="0" max="1" step="60" value="1" aria-label="Moment to show"/>
			<div class="tl-ends"><span data-tl-from></span><span>now</span></div>
		</div>
		<div class="tl-controls">
			<div class="tl-buttons" data-tl-buttons hidden>
				<button type="button" class="secondary icon" data-tl-prev title="Previous deployment (←)" aria-label="Previous deployment">
					<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3v10M13 3 6 8l7 5z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
				</button>
				<button type="button" class="tl-play" data-tl-play title="Play the deployments back (space)">Play</button>
				<button type="button" class="secondary icon" data-tl-next title="Next deployment (→)" aria-label="Next deployment">
					<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M13 3v10M3 3l7 5-7 5z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
				</button>
				if t.Kind == "matrix" {
					<label class="check tl-compare" title="Each version that is different today shows what runs now">
						<input type="checkbox" data-tl-compare/>
						<span>Compare with now</span>
					</label>
				}
				<span class="hint">← → step from deployment to deployment, Shift moves a day</span>
			</div>
			<form class="inline tl-exact" method="get" action={ templ.URL(t.Path) }>
				<label>Exact moment (UTC)<input type="datetime-local" name="at" value={ t.At } required data-tl-input/></label>
				for _, h := range t.Hidden {
					<input type="hidden" name={ h[0] } value={ h[1] }/>
				}
				<button type="submit" class="secondary">Show</button>
			</form>
		</div>
	</section>
}
