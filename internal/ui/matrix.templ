package ui

import "strings"

templ MatrixPage(v MatrixView) {
	@Layout(v.Base) {
		<div class="head">
			<div>
				<h1>Service × environment</h1>
				if v.At != "" {
					<p class="sub">As of <strong>{ strings.Replace(v.At, "T", " ", 1) } UTC</strong>: what ran then. Drift and upstream releases describe now, so they are not shown. <a href="/">Back to now</a></p>
				} else {
					<p class="sub">What runs where, the newest release upstream, and where versions drift apart.</p>
				}
			</div>
			if v.At == "" && len(v.Grid.Rows) > 0 {
				<div class="legend">
					<span class="badge env">behind previous env</span>
					<span class="badge upstream">upstream newer</span>
					<span class="badge inconsistent">targets disagree</span>
					<span class="badge declared">differs from Git</span>
					<span class="live off" data-live>Connecting…</span>
				</div>
			}
		</div>
		if v.At != "" || len(v.Grid.Rows) > 0 {
			<div class="toolbar">
				if len(v.Grid.Rows) > 0 {
					<nav class="segmented" aria-label="Group by">
						<span class="muted">Group by</span>
						for _, m := range matrixGroupModes {
							if v.Grid.GroupBy == m.Key {
								<a href={ templ.URL(matrixURL(m.Key, v.At)) } class="on" aria-current="page">{ m.Label }</a>
							} else {
								<a href={ templ.URL(matrixURL(m.Key, v.At)) }>{ m.Label }</a>
							}
						}
					</nav>
				}
				if v.At == "" && len(v.Grid.Rows) > 0 {
					<input type="search" id="matrix-q" class="search" placeholder="Filter services, owners, versions" aria-label="Filter services" aria-keyshortcuts="/" autocomplete="off"/>
					<label class="check"><input type="checkbox" id="matrix-drift"/> Only with drift</label>
					<span class="muted" id="matrix-count" aria-live="polite"></span>
				}
				<span class="spacer"></span>
				if v.Hygiene > 0 {
					<a href="/hygiene" class="toolbar-link">
						Image hygiene <span class="count">{ itoa(v.Hygiene) }</span>
					</a>
				}
				<a href={ templ.URL(exportURL(v.At)) } hx-boost="false" class="toolbar-link">Export CSV</a>
				<details class="menu timetravel" open?={ v.At != "" }>
					<summary>Time travel</summary>
					<div class="menu-list">
						<form class="stack" method="get" action="/">
							<label>Show the matrix as of (UTC)<input type="datetime-local" name="at" value={ v.At } required/></label>
							<input type="hidden" name="group" value={ v.Grid.GroupBy }/>
							<div class="actions">
								<button type="submit">Show</button>
								if v.At != "" {
									<a href={ templ.URL(matrixURL(v.Grid.GroupBy, "")) } class="button secondary">Back to now</a>
								}
							</div>
						</form>
					</div>
				</details>
			</div>
		}
		if v.At != "" {
			<section class="panel">
				@MatrixGridView(v.Grid)
			</section>
		} else {
			<section
				class="panel"
				hx-get={ "/ui/matrix?group=" + v.Grid.GroupBy }
				hx-trigger="goliash:changed from:body, every 60s"
				hx-swap="innerHTML"
				aria-live="polite"
			>
				@MatrixGridView(v.Grid)
			</section>
		}
	}
}

templ MatrixGridView(g MatrixGrid) {
	if len(g.Rows) == 0 {
		@firstRun(g.Steps)
	} else {
		<div class="scroll">
			<table class="matrix">
				<thead>
					<tr>
						<th>Service</th>
						for _, e := range g.Envs {
							<th class="env">
								{ e.Name }
								<small>{ plural(e.Targets, "target", "targets") }</small>
							</th>
						}
						<th>Latest upstream</th>
					</tr>
				</thead>
				for _, grp := range g.Groups {
				<tbody class={ "mgroup", templ.KV("named", grp.Name != "") }>
					if grp.Name != "" {
						<tr class="group-head">
							<th colspan={ itoa(len(g.Envs) + 2) } scope="rowgroup">
								<div class="group-line">
									if g.GroupBy == "app" || g.GroupBy == "team" {
										<span class={ "app-avatar", versionColour(grp.Name) } aria-hidden="true">{ initial(grp.Name) }</span>
									}
									<span class="group-name">{ grp.Name }</span>
									<span class="count-pill">{ itoa(len(grp.Rows)) }</span>
									if grp.Caption != "" {
										<small>{ grp.Caption }</small>
									}
									if g.GroupBy != "status" {
										@groupHealth(grp)
									}
								</div>
							</th>
						</tr>
					}
					for _, r := range grp.Rows {
						<tr data-search={ rowSearch(r) } data-drift={ rowDrift(r) } data-health={ r.Health }>
							<td class="svc">
								<a href={ templ.URL(r.URL) }>{ r.Service }</a>
								if r.Split && g.GroupBy != "app" {
									<span class="part" title="Used by several applications: versions are compared within each">{ "in " + orOther(r.App) }</span>
								}
								if r.Owner != "" {
									<span class="owner">{ r.Owner }</span>
								}
							</td>
							for i, c := range r.Cells {
								<td data-label={ envLabel(g.Envs, i) }>
									@cellView(c)
								</td>
							}
							<td class="latest" data-label="Upstream">
								if r.Latest != "" && r.LatestURL != "" {
									<a class="tag" href={ templ.URL(r.LatestURL) } target="_blank" rel="noopener noreferrer" title="Release notes">{ r.Latest }</a>
								} else if r.Latest != "" {
									<span class="tag">{ r.Latest }</span>
								} else {
									<span class="none">—</span>
								}
								if r.Note != "" {
									<div class="targets" title={ r.NoteTitle }>{ r.Note }</div>
								}
							</td>
						</tr>
					}
				</tbody>
				}
			</table>
		</div>
		if g.Unmapped > 0 {
			<div class="panel-head" style="border-top:1px solid var(--line);border-bottom:0">
				<span class="muted">{ plural(g.Unmapped, "workload is", "workloads are") } not mapped to a service.</span>
				<a href="/inbox">Open inbox →</a>
			</div>
		}
	}
}

// groupHealth is a group's share of current services, as a stacked bar.
templ groupHealth(grp MatrixGroup) {
	{{ ok, warn, bad := grp.healthBar(96) }}
	<span class="group-health" title={ itoa(grp.OK) + " up to date, " + itoa(grp.Warn) + " behind, " + itoa(grp.Bad) + " need attention" }>
		<svg width="96" height="6" viewBox="0 0 96 6" aria-hidden="true">
			<rect class="hb-bg" width="96" height="6" rx="3"></rect>
			<rect class="hb-ok" width={ f(ok) } height="6"></rect>
			<rect class="hb-warn" x={ f(ok) } width={ f(warn) } height="6"></rect>
			<rect class="hb-bad" x={ f(ok + warn) } width={ f(bad) } height="6"></rect>
		</svg>
		<span>{ itoa(grp.OK) + " of " + itoa(len(grp.Rows)) + " current" }</span>
	</span>
}

// resolvedTag shows the exact release behind a moving tag ("1 = 1.27.3").
templ resolvedTag(tag, resolved string) {
	if resolved != "" {
		<span class="resolved" title={ tag + " is a moving tag; the image that runs is " + resolved + " (same digest)" }>= { resolved }</span>
	}
}

templ cellView(c MatrixCell) {
	if len(c.Versions) == 0 {
		<span class="none">—</span>
	} else {
		<div class="cell">
			for _, v := range c.Versions {
				<div class="ver">
					<span class="tag">{ v.Tag }</span>
					@resolvedTag(v.Tag, v.Resolved)
					<span class="reps">× { itoa(v.Running) }</span>
				</div>
				if v.Targets != "" {
					<div class="targets">{ v.Targets }</div>
				}
			}
			if len(c.Drifts) > 0 || c.StaleTitle != "" || c.FromDeclared {
				<div class="badges">
					if c.FromDeclared {
						<span class="badge declared-only" title="Declared in Compose files; nothing reports what actually runs here.">declared</span>
					}
					for _, d := range c.Drifts {
						<span class={ "badge", d.Kind } title={ d.Title }>{ d.Label }</span>
					}
					if c.StaleTitle != "" {
						<span class="badge stale" title={ c.StaleTitle }>stale data</span>
					}
				</div>
			}
		</div>
	}
}

templ firstRun(steps []Step) {
	<div class="first-run">
		<h2>Get started</h2>
		<p class="muted">The matrix fills in once a target reports and its workloads belong to services.</p>
		<ol class="steps">
			for _, st := range steps {
				<li class={ templ.KV("done", st.Done) }>
					<span class="step-mark" aria-hidden="true"></span>
					<div>
						<strong>{ st.Title }</strong>
						if st.Optional {
							<span class="muted">optional</span>
						}
						if st.Done {
							<span class="sr-only">(done)</span>
						}
						<p class="muted">{ st.Text }</p>
					</div>
					if !st.Done {
						<a class="button secondary" href={ templ.URL(st.Href) }>{ st.Action }</a>
					}
				</li>
			}
		</ol>
		<p class="hint">Just looking? Run <code>goliash demo</code> on the server to fill this workspace with three weeks of example data.</p>
	</div>
}
