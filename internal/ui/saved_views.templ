package ui

// viewTabsBar is the saved views above the matrix and the tiles: one click to a team, an environment or a wall
// screen's board, and the page as it is now saved as a new one.
templ viewTabsBar(t ViewTabs) {
	if len(t.Tabs) > 0 || t.CanSave {
		<div class="view-tabs noprint">
			<nav class="view-tab-list" aria-label="Saved views">
				<a class={ "view-tab", templ.KV("on", !t.AnyActive) } href={ templ.URL(t.AllURL) } aria-current?={ !t.AnyActive }>All</a>
				for _, tab := range t.Tabs {
					<a class={ "view-tab", templ.KV("on", tab.Active) } href={ templ.URL(tab.URL) } aria-current?={ tab.Active } title={ viewTabTitle(tab) }>
						if tab.Home {
							<span class="view-home" aria-hidden="true">⌂</span>
						}
						{ tab.Name }
						if tab.Shared {
							<span class="sr-only">(for everyone)</span>
						}
					</a>
				}
			</nav>
			for _, tab := range t.Tabs {
				if tab.Active {
					<span class="view-actions">
						if t.CanSave {
							<form method="post" action={ templ.URL("/views/" + tab.ID + "/home") } class="inline">
								<button type="submit" class="link">
									if tab.Home {
										Not my home
									} else {
										Make it my home
									}
								</button>
							</form>
						}
						if tab.CanDelete {
							<form method="post" action={ templ.URL("/views/" + tab.ID + "/delete") } class="inline" hx-confirm={ "Delete the view " + tab.Name + "?" }>
								<button type="submit" class="link danger-link">Delete</button>
							</form>
						}
					</span>
				}
			}
			if t.CanSave && !t.AnyActive {
				<details class="view-save">
					<summary class="link">+ Save view</summary>
					<form method="post" action="/views" class="app-actions" data-save-view>
						<input type="hidden" name="url" value={ t.Current }/>
						<input name="name" required maxlength="60" placeholder="Name, e.g. team-payments" aria-label="Name of the view" data-focus-open/>
						if t.CanShare {
							<label class="check"><input type="checkbox" name="shared" value="1"/> For everyone</label>
						}
						<button type="submit">Save</button>
					</form>
					<p class="hint">Keeps the page as it is now: its grouping, team or application, environment, filters, TV mode.</p>
				</details>
			}
		</div>
	}
}

func viewTabTitle(t ViewTab) string {
	who := "Your view"
	if t.Shared {
		who = "For everyone in the workspace"
	}
	if t.Home {
		who += "; Goliash opens with it"
	}
	return who
}
