package ui

import "strings"

templ InboxPage(v InboxView) {
	@Layout(v.Base) {
		<div class="head">
			<div>
				<h1>Inbox</h1>
				<p class="sub">Workloads Goliash could not map to a service, grouped by image. Your choice becomes a rule, so the next ones map by themselves.</p>
			</div>
		</div>
		<section class="panel">
			if len(v.Groups) == 0 {
				<div class="empty">Nothing to classify. Every running workload belongs to a service.</div>
			} else {
				<datalist id="services">
					for _, s := range v.Services {
						<option value={ s }></option>
					}
				</datalist>
				<div class="scroll">
					<table>
						<thead><tr><th>Image</th><th>Workloads</th><th>Service</th></tr></thead>
						<tbody>
							for _, g := range v.Groups {
								<tr>
									<td>
										<span class="mono">{ g.Repo }</span>
										<div class="targets">{ strings.Join(g.Tags, ", ") }</div>
									</td>
									<td>
										@inboxWorkloads(v, g)
									</td>
									<td>
										if v.CanMember {
											<form class="inline" method="post" action="/inbox/map">
												<input type="hidden" name="repo" value={ g.Repo }/>
												<input name="service" list="services" value={ g.Suggested } required aria-label="Service name" size="16"/>
												<button type="submit">
													if len(g.Workloads) == 1 {
														Map
													} else {
														{ "Map all " + itoa(len(g.Workloads)) }
													}
												</button>
											</form>
											<form class="inline" method="post" action="/inbox/ignore" style="margin-top:6px">
												<input type="hidden" name="repo" value={ g.Repo }/>
												<button class="link" type="submit">Ignore this image</button>
											</form>
										} else {
											<span class="muted">suggested: { g.Suggested }</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
		<section class="panel">
			<div class="panel-head"><h2>Mapping rules</h2><span class="muted">first match wins, top to bottom</span></div>
			if len(v.Rules) == 0 {
				<div class="empty">No rules yet. Mapping or ignoring an image above creates one.</div>
			} else {
				<div class="scroll">
					<table>
						<thead>
							<tr>
								<th>Match</th>
								<th>Pattern</th>
								<th>Service</th>
								<th>Created</th>
								if v.CanMember {
									<th><span class="sr-only">Actions</span></th>
								}
							</tr>
						</thead>
						<tbody>
							for _, r := range v.Rules {
								<tr>
									<td>{ r.Match }</td>
									<td class="mono">{ r.Pattern }</td>
									<td>
										if r.Service == "" {
											<span class="badge neutral">ignored</span>
										} else {
											<a href={ templ.URL("/services/" + r.Service) }>{ r.Service }</a>
										}
									</td>
									<td>@timeAgo(r.Created)</td>
									if v.CanMember {
										<td class="num">
											<form method="post" action={ templ.URL("/inbox/rules/" + r.ID + "/delete") } hx-confirm="Delete this rule? Workloads it matched return to the inbox with the next snapshot, unless another rule or a label maps them.">
												<button class="link danger-link" type="submit">Delete</button>
											</form>
										</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
	}
}

// inboxWorkloads lists a group's workloads. With several, each can be mapped on its
// own, for an image that runs as more than one service.
templ inboxWorkloads(v InboxView, g InboxGroup) {
	if len(g.Workloads) == 1 {
		@inboxWorkload(g.Workloads[0])
	} else {
		<details>
			<summary>{ plural(len(g.Workloads), "workload", "workloads") } in { strings.Join(g.Envs, ", ") }</summary>
			<div class="stack">
				for _, it := range g.Workloads {
					<div>
						@inboxWorkload(it)
						if v.CanMember {
							<form class="inline" method="post" action="/inbox/map" style="margin-top:4px">
								<input type="hidden" name="repo" value={ g.Repo }/>
								<input type="hidden" name="only" value="workload"/>
								<input type="hidden" name="workload_name" value={ it.Workload }/>
								<input name="service" list="services" value={ it.Workload } required aria-label={ "Service for " + it.Workload } size="12"/>
								<button class="secondary" type="submit">Map only this</button>
							</form>
						}
					</div>
				}
			</div>
		</details>
	}
}

templ inboxWorkload(it InboxItem) {
	<strong>{ it.Workload }</strong>
	<div class="targets">{ it.Kind }{ nsSuffix(it.Namespace) } · { it.Target } · { it.Env }</div>
}
