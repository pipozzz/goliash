package ui

templ PromotionsPage(v PromotionsView) {
	@Layout(v.Base) {
		<div class="head">
			<div>
				<h1>Delivery</h1>
				<p class="sub"><a href="/report">Monthly report →</a></p>
				<p class="sub">What waits to be promoted, and how versions move through the environments, read from what ran when.</p>
			</div>
		</div>
		<section class="panel">
			<div class="panel-head"><h2>Waiting for promotion</h2></div>
			if len(v.Promotions) == 0 {
				<div class="empty">Nothing waits: every environment runs what the one before it runs.</div>
			} else {
				<div class="scroll">
					<table>
						<thead><tr><th>Service</th><th>Promote</th><th>Waiting</th><th>Releases it brings</th></tr></thead>
						<tbody>
							for _, p := range v.Promotions {
								<tr>
									<td><a href={ templ.URL("/services/" + p.Service) }><strong>{ p.Service }</strong></a></td>
									<td>
										<span class="mono">{ p.Version }</span>
										<div class="targets">{ p.From } → { p.To } (runs <span class="mono">{ p.Running }</span>)</div>
									</td>
									<td>@timeAgo(p.Since)</td>
									<td>
										if len(p.Releases) == 0 {
											<span class="muted">—</span>
										} else {
											<div class="stack" style="gap:4px">
												for _, r := range p.Releases {
													<div>
														<span class="mono">{ r.Version }</span>
														if r.URL != "" {
															<a href={ templ.URL(r.URL) } target="_blank" rel="noopener noreferrer">release notes</a>
														}
													</div>
												}
											</div>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
		<section class="panel">
			<div class="panel-head"><h2>Last 30 days</h2><span class="hint">Versions that arrived per environment, and the median time a version took to reach the next one</span></div>
			if len(v.Delivery) == 0 {
				<div class="empty">No services yet.</div>
			} else {
				<div class="scroll">
					<table>
						<thead>
							<tr>
								<th>Service</th>
								for _, e := range v.EnvNames {
									<th class="num">{ e }</th>
								}
								for _, l := range v.LeadNames {
									<th class="num">{ l }</th>
								}
							</tr>
						</thead>
						<tbody>
							for _, d := range v.Delivery {
								<tr>
									<td><a href={ templ.URL("/services/" + d.Service) }><strong>{ d.Service }</strong></a></td>
									for _, c := range d.Envs {
										<td class="num">
											{ itoa(c.Deploys) }
											if !c.Last.IsZero() {
												<div class="targets">
													{ "last " }
													@timeAgo(c.Last)
												</div>
											}
										</td>
									}
									for _, l := range d.Leads {
										<td class="num mono">{ l }</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
	}
}
