package ui

import (
	"fmt"

	"github.com/pipozzz/goliash/internal/versions"
)

templ PromotionsPage(v PromotionsView) {
	@Layout(v.Base) {
		<div class="head">
			<div>
				<h1>Delivery</h1>
				<p class="sub"><a href="/report">Monthly report →</a> <a href="/gitops">GitOps applications →</a></p>
				@aboutText("What waits to be promoted, and how versions move through the environments, read from what ran when.")
			</div>
		</div>
		if len(v.Rollouts) > 0 {
			<section class="panel">
				<div class="panel-head"><h2>Rollouts that do not finish</h2>@panelInfo("replicas not where the platform was asked to put them")</div>
				<div class="scroll" tabindex="0">
					<table class="cards">
						<thead><tr><th>Service</th><th>Where</th><th>What</th><th>Since</th></tr></thead>
						<tbody>
							for _, is := range v.Rollouts {
								<tr>
									<td data-label="Service" class="svc"><a href={ templ.URL("/services/" + is.Service) }><strong>{ is.Service }</strong></a></td>
									<td data-label="Where">
										{ is.Environment }
										<div class="targets">{ is.Target + " · " + is.Workload }</div>
									</td>
									<td data-label="What">
										<span class={ "badge", rolloutBadge(is.Kind) }>{ rolloutLabel(is.Kind) }</span>
										<div class="targets">{ rolloutDetail(is) }</div>
									</td>
									<td data-label="Since">@timeAgo(is.Since)</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		}
		<section class="panel">
			<div class="panel-head"><h2>Deploys per week</h2>@panelInfo("versions that arrived, by environment, last 12 weeks")</div>
			@stackedBars(v.Deploys, "Deploys per week by environment, last 12 weeks")
		</section>
		<section class="panel">
			<div class="panel-head"><h2>Open drift</h2>@panelInfo("per day and kind, last 30 days")</div>
			if len(nonZeroSeries(v.Drift.Series)) == 0 {
				<div class="empty">No drift in the last 30 days.</div>
			} else {
				@lines(v.Drift, "Open drift per day by kind, last 30 days")
			}
		</section>
		<section class="panel">
			<div class="panel-head"><h2>Waiting for promotion</h2></div>
			for _, ap := range v.AppPromotions {
				<div class="app-promote">
					<div>
						<strong>{ ap.App }</strong> <span class="muted">{ "on " + ap.Target + ": " + itoa(len(ap.Services)) + " services wait for " + ap.To }</span>
						<div class="targets">{ joinList(ap.Services) }</div>
					</div>
					<a class="button gitops-pr noprint" href={ templ.URL(ap.URL) } title="One pull request with every service's new tag: see it before opening it">{ "Promote " + ap.App + " → " + ap.To }</a>
				</div>
			}
			if len(v.Promotions) == 0 {
				<div class="empty">Nothing waits: every environment runs what the one before it runs.</div>
			} else {
				<div class="scroll" tabindex="0">
					<table>
						<thead><tr><th>Service</th><th>Promote</th><th>Waiting</th><th>Releases it brings</th></tr></thead>
						<tbody>
							for _, p := range v.Promotions {
								<tr>
									<td class="svc">
										<a href={ templ.URL("/services/" + p.Service) }><strong>{ p.Service }</strong></a>
										if p.App != "" {
											<span class="part">{ "in " + p.App }</span>
										}
									</td>
									<td>
										<span class="mono">{ p.Version }</span>
										<div class="targets">{ p.From } → { p.To } (runs <span class="mono">{ p.Running }</span>)</div>
										if p.Vulns.Known && (len(p.Vulns.Fixed) > 0 || len(p.Vulns.New) > 0) {
											@promotionVulns(p.Vulns)
										}
										if p.Licenses.Known && len(p.Licenses.Changes) > 0 {
											<div class="error-text promo-licenses" title={ "From the SBOMs of both images; not legal advice: " + licensePlain(p.Licenses.Changes) }>{ "⚖️ brings " + licenseShort(p.Licenses.Changes) }</div>
										}
										if v.CanMember || v.PreviewPRs {
											for _, pr := range p.PRs {
												if pr.URL != "" {
													<a class="gitops-pr" href={ templ.SafeURL(pr.URL) } target="_blank" rel="noopener">{ pullLabel(p.To, pr.State) }</a>@prChecks(pr.Checks)
													continue
												}
												<a class="button secondary gitops-pr noprint" href={ templ.URL("/services/" + p.Service + "/gitops/preview?" + previewQuery(pr.TargetID, pr.WorkloadID, p.Version, "/delivery")) } title={ "See the pull request in the repository " + pr.App + " deploys from before opening it" }>
													{ "Open PR → " + p.To }
													if len(p.PRs) > 1 {
														{ " (" + pr.Target + ")" }
													}
												</a>
											}
										}
										if v.Goli && p.Running != "" && p.Version != p.Running {
											<button type="button" class="link ask-goli noprint" data-goli-ask={ promotionBrief(p) } title="Goli reads the release notes between the two versions and briefs you">Brief</button>
										}
									</td>
									<td>@timeAgo(p.Since)</td>
									<td>
										if len(p.Releases) == 0 {
											<span class="muted">—</span>
										} else {
											<div class="stack" style="gap:4px">
												for _, r := range p.Releases {
													<div>
														<span class="mono">{ r.Version }</span>
														if r.URL != "" {
															<a href={ templ.URL(r.URL) } target="_blank" rel="noopener noreferrer">release notes</a>
														}
													</div>
												}
											</div>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
		if len(v.Pulls) > 0 {
			@pullsPanel(v.Pulls)
		}
		<section class="panel">
			<div class="panel-head"><h2>Last 30 days</h2>@panelInfo("Versions that arrived per environment, and the median time a version took to reach the next one")</div>
			if len(v.Delivery) == 0 {
				<div class="empty">No services yet.</div>
			} else {
				<div class="scroll" tabindex="0">
					<table>
						<thead>
							<tr>
								<th>Service</th>
								for _, e := range v.EnvNames {
									<th class="num">{ e }</th>
								}
								for _, l := range v.LeadNames {
									<th class="num">{ l }</th>
								}
							</tr>
						</thead>
						<tbody>
							for _, d := range v.Delivery {
								<tr>
									<td><a href={ templ.URL("/services/" + d.Service) }><strong>{ d.Service }</strong></a></td>
									for _, c := range d.Envs {
										<td class="num">
											{ itoa(c.Deploys) }
											if c.Rollbacks > 0 {
												<div class="targets error-text">{ plural(c.Rollbacks, "rollback", "rollbacks") }</div>
											}
											if !c.Last.IsZero() {
												<div class="targets">
													{ "last " }
													@timeAgo(c.Last)
												</div>
											}
										</td>
									}
									for _, l := range d.Leads {
										<td class="num mono">{ l }</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
	}
}

// promotionBrief is what the Brief button asks Goli before promoting a version to the next environment.
func promotionBrief(p PromotionView) string {
	return "Brief me on promoting " + p.Service + " " + p.Version + " from " + p.From + " to " + p.To + ", where " + p.Running +
		" runs: what changes between the two versions, what could break or needs migrating, and what to check after."
}

// promotionVulns says what a promotion does to the known vulnerabilities of the environment behind.
templ promotionVulns(d versions.VulnDelta) {
	<details class="promo-vulns">
		<summary>
			if len(d.Fixed) > 0 {
				<span class="fix">{ "fixes " + plural(len(d.Fixed), "vulnerability", "vulnerabilities") + exploitedNote(d.Fixed) }</span>
			}
			if len(d.Fixed) > 0 && len(d.New) > 0 {
				{ " · " }
			}
			if len(d.New) > 0 {
				<span class="error-text">{ "brings " + plural(len(d.New), "new one", "new ones") + exploitedNote(d.New) }</span>
			}
		</summary>
		<div class="targets mono">
			if len(d.Fixed) > 0 {
				<div>{ "fixed: " + vulnIDs(d.Fixed) }</div>
			}
			if len(d.New) > 0 {
				<div>{ "new: " + vulnIDs(d.New) }</div>
			}
		</div>
	</details>
}

// pullsPanel lists the pull requests Goliash opened, from proposal to running.
templ pullsPanel(pulls []PullView) {
	<section class="panel" id="pulls">
		<div class="panel-head">
			<h2>Pull requests</h2>
			if d, n := medianToRunning(pulls); n > 0 {
				<span class="muted" title={ fmt.Sprintf("The median over %d pull requests whose version runs", n) }>{ versions.HumanDuration(d) } from pull request to running</span>
			}
			@panelInfo("Pull requests Goliash opened in the last 30 days, by someone or by a version policy (auto-pr): open, merged or closed, whether the version they pin runs there now, and how long after opening it began to.")
		</div>
		<div class="scroll" tabindex="0">
			<table class="cards">
				<thead><tr><th>Service</th><th>Where</th><th>Upgrade</th><th>State</th><th>Opened</th></tr></thead>
				<tbody>
					for _, p := range pulls {
						<tr>
							<td data-label="Service" class="svc"><a href={ templ.URL(p.ServiceURL) }><strong>{ p.Service }</strong></a></td>
							<td data-label="Where">{ p.Environment }<div class="targets">{ p.Target }</div></td>
							<td data-label="Upgrade" class="mono"><a href={ templ.SafeURL(p.URL) } target="_blank" rel="noopener">{ p.From + " → " + p.To }</a></td>
							<td data-label="State">
								<span class="badges">
									<span class={ "badge", pullStateClass(p.State) }>{ p.State }</span>
									if p.State == "open" {
										@prChecks(p.Checks)
									}
									if p.Deployed {
										<span class="badge ok">running</span>
									} else if !p.MergedAt.IsZero() {
										<span class="badge neutral not-deployed" title={ "Merged, and " + p.To + " does not run there yet" }>not deployed</span>
									}
								</span>
								if !p.MergedAt.IsZero() {
									<div class="targets">merged @timeAgo(p.MergedAt)</div>
									if p.Waiting != "" {
										<div class="targets">{ p.Waiting }</div>
									}
								}
								if p.ToRunning > 0 {
									<div class="targets">{ versions.HumanDuration(p.ToRunning) } after opening</div>
								}
							</td>
							<td data-label="Opened">@timeAgo(p.OpenedAt)<div class="targets">{ "by " + p.OpenedBy }</div></td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
}
