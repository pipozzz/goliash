package ui

import (
	"strings"
	"time"

	"github.com/pipozzz/goliash/internal/versions"
)

// VulnsPage answers "is this vulnerability running?" and lists the known vulnerabilities of running images.
templ VulnsPage(v VulnsView) {
	@Layout(v.Base) {
		<div class="head">
			<div>
				<p><a href="/security">Security</a> / vulnerabilities</p>
				<h1>Known vulnerabilities</h1>
				<p class="sub">{ "From the SBOMs of " + itoa(v.WithSBOM) + " of " + itoa(v.Images) + " running images" + inEnv(v) + ", looked up on OSV. Images without an SBOM are not covered." }</p>
			</div>
			<span class="noprint actions">
				<a class="button secondary" href={ templ.URL(vulnsCSVHref(v)) } hx-boost="false">Export CSV</a>
				if v.OnlyKEV {
					<a href={ templ.URL(vulnsHref(v, "kev", "")) }>Every vulnerability</a>
				} else {
					<a href={ templ.URL(vulnsHref(v, "kev", "1")) }>Only exploited in the wild</a>
				}
				if v.Exposed {
					<a href={ templ.URL(vulnsHref(v, "exposed", "")) }>Exposed or not</a>
				} else {
					<a href={ templ.URL(vulnsHref(v, "exposed", "1")) } title="Only in images reachable from outside their cluster or host">Only exposed</a>
				}
				if v.All {
					<a href={ templ.URL(vulnsHref(v, "env", "")) }>{ "Only " + v.EnvName }</a>
				} else {
					<a href={ templ.URL(vulnsHref(v, "env", "all")) }>Every environment</a>
				}
			</span>
		</div>
		<form class="row vuln-search" method="get" action="/security/vulns">
			if v.All {
				<input type="hidden" name="env" value="all"/>
			}
			if v.OnlyKEV {
				<input type="hidden" name="kev" value="1"/>
			}
			if v.Exposed {
				<input type="hidden" name="exposed" value="1"/>
			}
			<label class="grow"><span class="sr-only">Vulnerability, package or service</span><input name="q" value={ v.Query } placeholder="CVE-2024-3094, openssl, payments-api"/></label>
			<button type="submit">Check</button>
		</form>
		if !v.Enabled {
			<div class="notice error">Vulnerability lookups are off on this server (GOLIASH_OSV_URL=off).</div>
		}
		if v.Pending > 0 || v.Unasked > 0 {
			<div class="notice pending">{ "Still looking up " + plural(v.Pending, "advisory", "advisories") + " and " + plural(v.Unasked, "package", "packages") + " on OSV; until then a vulnerability may be listed under another ID, and an answer may be incomplete." }</div>
		}
		if v.Query != "" && len(v.Shown) == 0 {
			<section class={ "panel", "answer", templ.KV("answer-ok", v.LooksCVE && v.Pending == 0 && v.Unasked == 0) }>
				<div class="panel-body">
					if v.LooksCVE && (v.Pending > 0 || v.Unasked > 0) {
						<h2>{ strings.ToUpper(v.Query) } not found yet</h2>
					} else if v.LooksCVE {
						<h2>{ strings.ToUpper(v.Query) } is not running</h2>
					} else {
						<h2>Nothing matches { v.Query }</h2>
					}
					<p class="muted">{ "As far as the SBOMs of " + itoa(v.WithSBOM) + " of " + itoa(v.Images) + " running images" + inEnv(v) + " tell. " + plural(v.Images-v.WithSBOM, "image has", "images have") + " no SBOM Goliash could read." }</p>
				</div>
			</section>
		} else if len(v.Shown) > 0 {
			<section class="panel">
				<div class="scroll" tabindex="0">
					<table>
						<thead><tr><th>Vulnerability</th><th>Severity</th><th>Running in</th></tr></thead>
						<tbody>
							for _, f := range v.Shown {
								<tr>
									<td>
										<a class="mono" href={ templ.URL(vulnURL(f.IDs[0])) } target="_blank" rel="noopener noreferrer"><strong>{ f.Key }</strong></a>
										if f.Summary != "" {
											<div class="targets">{ f.Summary }</div>
										}
										if d := f.DaysRunning(time.Now()); !f.Since.IsZero() {
											<div class="targets">{ "running for " + plural(d, "day", "days") }</div>
										}
										if len(f.IDs) > 1 || f.IDs[0] != f.Key {
											<div class="targets mono">{ strings.Join(f.IDs, ", ") }</div>
										}
										if len(f.Aliases) > 1 {
											<div class="targets mono">{ "also " + strings.Join(f.Aliases, ", ") }</div>
										}
										if v.Goli {
											<button type="button" class="link ask-goli noprint" data-goli-ask={ explainVuln(f.Key) } title="Goli explains what it means for what runs here">Explain</button>
										}
									</td>
									<td>
										if ways := exposedWays(f); len(ways) > 0 {
											@exposedBadge(ways, "eol")
										}
										if f.Exploited != nil {
											<span class="badge eol" title={ "CISA: " + f.Exploited.Name + ", added " + f.Exploited.DateAdded }>exploited</span>
											if f.Exploited.Ransomware {
												<span class="badge eol">ransomware</span>
											}
											if f.PastDue(time.Now()) {
												<span class="badge eol" title="CISA's due date for fixing it (BOD 22-01) has passed">past due</span>
											}
											if f.Exploited.DueDate != "" {
												<div class="targets">{ "CISA due " + f.Exploited.DueDate }</div>
											}
										}
										if f.NoFix() {
											@mitigationCell(v, f)
										}
										if f.Severity != "" {
											<span class={ "badge", severityClass(f.Severity) }>{ strings.ToLower(f.Severity) }</span>
										} else if f.Exploited == nil {
											<span class="muted">—</span>
										}
									</td>
									<td>
										for _, u := range byPackage(f) {
											<div class="vuln-use">
												<span class="mono">{ u.Package }</span>
												if u.Fix != "" {
													<span class="fix">{ "→ fixed in " + u.Fix }</span>
												} else if u.Newer != nil {
													<span class="fix" title={ u.Newer.Advice(u.Current) }>{ "→ fixed in " + u.Newer.Label() }</span>
												} else if u.Upstream != nil {
													<span class="fix" title={ u.Upstream.Advice(f.Key) }>{ "→ " + u.Upstream.Short() }</span>
												} else {
													<span class="muted">no fix yet</span>
												}
												<div class="targets">{ strings.Join(u.Where, ", ") }</div>
											</div>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				if v.Hidden > 0 {
					<p class="hint panel-note">{ plural(v.Hidden, "more vulnerability", "more vulnerabilities") } not shown; search to narrow the list.</p>
				}
			</section>
		} else if v.Query == "" {
			@vulnsEmpty(v)
		}
	}
}

// vulnsEmpty says why the list is empty: nothing known in what Goliash could read, the filters, or nothing read.
templ vulnsEmpty(v VulnsView) {
	<section class="panel">
		<div class="empty stack">
			if v.Packages == 0 {
				<p><strong>No packages known yet</strong>, so no vulnerabilities either.</p>
				<p class="muted">Goliash reads them from the SBOMs attached to the running images (or from the image's package database). Images built without one stay blind spots; the build step that adds an SBOM is on the <a href="/security">Security page</a> under blind spots.</p>
			} else if v.OnlyKEV || v.Exposed {
				<p><strong>Nothing with these filters</strong> in the { plural(v.Packages, "package", "packages") } of { plural(v.WithSBOM, "image", "images") }.</p>
				<p class="muted"><a href={ templ.URL(vulnsUnfiltered(v)) }>Show every vulnerability</a></p>
			} else {
				<p><strong>No known vulnerabilities</strong> in the { plural(v.Packages, "package", "packages") } of the { plural(v.WithSBOM, "image", "images") } with an SBOM{ inEnv(v) }.</p>
			}
			if len(v.Blind) > 0 {
				<p class="muted">{ plural(len(v.Blind), "running image has", "running images have") } no known packages, so what they carry is not covered. See the blind spots on the <a href="/security">Security page</a>.</p>
			}
		</div>
	</section>
}

func severityClass(s string) string {
	switch strings.ToUpper(s) {
	case "CRITICAL", "HIGH":
		return "eol"
	case "MODERATE", "MEDIUM":
		return "env"
	}
	return "neutral"
}

func inEnv(v VulnsView) string {
	if v.All {
		return ""
	}
	return " in " + v.EnvName
}

// explainVuln is what the Explain button asks Goli about a vulnerability.
func explainVuln(id string) string {
	return "Explain " + id + " for us: what it is in plain words, which running services and environments have it, " +
		"whether it is exploited in the wild, what fixes it, and how urgent it is here."
}

// mitigationCell says, for an exploited vulnerability with no fix, where it is mitigated and how, and lets a member
// record a mitigation where it is not.
templ mitigationCell(v VulnsView, f versions.VulnFinding) {
	<span class="badge eol" title="No affected package has a fixed version yet: only a mitigation keeps it from being used">no fix</span>
	for _, m := range mitigationsOf(f) {
		<div class="targets mitigation">
			<span class="badge ok">mitigated</span>
			{ " " + m.Where + ": " + m.Measure + " (" + m.Kind + ", review " + m.Review + ")" }
			if v.CanMember {
				<form class="inline" method="post" action={ templ.URL("/security/mitigations/" + m.ID + "/close") }>
					<button type="submit" class="link" title="Withdraw this mitigation">withdraw</button>
				</form>
			}
		</div>
	}
	if places := f.Unmitigated(); len(places) > 0 {
		<div class="targets">
			if due := f.MitigateBy(v.ExploitedDays); !due.IsZero() {
				<span class={ templ.KV("error-text", time.Now().After(due)) }>{ "Mitigate by " + due.Format("2 Jan 2006") + ": " }</span>
			} else {
				{ "Not mitigated: " }
			}
			{ placesText(places) }
		</div>
		if v.CanMember {
			<details class="mitigate">
				<summary>Record a mitigation</summary>
				<form class="stack" method="post" action="/security/mitigations">
					<input type="hidden" name="cve" value={ f.Key }/>
					<input type="hidden" name="return" value={ vulnsHref(v, "", "") }/>
					<label>
						Where
						<select name="place">
							for _, a := range places {
								<option value={ a.ServiceID + "|" + a.EnvironmentID }>{ a.Service + " (" + a.Env + ")" }</option>
							}
						</select>
					</label>
					<label>
						What
						<select name="kind">
							<option value="waf">WAF or proxy rule</option>
							<option value="config">feature or setting turned off</option>
							<option value="isolation">cut off from the network</option>
							<option value="other">other</option>
						</select>
					</label>
					<label>Measure<input name="measure" required maxlength="500" placeholder="WAF rule blocks ${jndi: in headers and bodies"/></label>
					<label>
						Review in
						<select name="review">
							<option value="14">2 weeks</option>
							<option value="30" selected>30 days</option>
							<option value="90">90 days</option>
						</select>
					</label>
					<div><button type="submit">Record</button></div>
				</form>
			</details>
		}
	}
}
