package ui

import "strings"

templ ServicePage(v ServiceView) {
	@Layout(v.Base) {
		<div class="head">
			<div>
				<p class="muted"><a href="/">Matrix</a> / service</p>
				<h1>{ v.Name }</h1>
			</div>
			if v.CanMember && v.PublicRegistry {
				<form method="post" action={ templ.URL("/services/" + v.Name + "/check") } class="inline">
					<button class="secondary" type="submit">Check upstream now</button>
				</form>
			}
		</div>
		<dl class="facts">
			<div class="fact"><dt>Owner</dt><dd>{ orDash(v.Owner) }</dd></div>
			<div class="fact"><dt>Kind</dt><dd>{ kindLabel(v.Kind) }</dd></div>
			<div class="fact"><dt>Upstream</dt><dd class="mono">{ orDash(v.RefRepo) }</dd></div>
			<div class="fact">
				<dt>Latest acceptable</dt>
				<dd class="mono">{ orDash(v.Latest) }</dd>
			</div>
			<div class="fact">
				<dt>Last checked</dt>
				<dd>
					if v.Private {
						<span class="muted">by the agent</span>
					} else {
						@timeAgo(v.CheckedAt)
					}
				</dd>
			</div>
		</dl>
		if v.CheckError != "" {
			<div class="notice error">
				Upstream check failed: { v.CheckError }
				if v.Private && strings.Contains(v.CheckError, "denied") {
					<p class="hint">
						The agents check this registry with their own credentials: a <code>GOLIASH_CREDENTIAL_…</code> variable named after the registry host, a <code>docker login</code> on the host, or the cluster's image pull secrets.
						<a href="https://goliash.dev/reference/collectors/#private-registries" target="_blank" rel="noopener">How to give agents credentials</a>
					</p>
				}
			</div>
		}
		if v.LatestAny != "" && v.LatestAny != v.Latest {
			<p class="muted">{ v.LatestAny } is out, outside the pinned major; it is shown as information, not alerted.</p>
		}
		if len(v.Versions.Lanes) > 0 {
			<section class="panel">
				<div class="panel-head"><h2>Versions over time</h2><span class="muted">last 30 days; hover for dates</span></div>
				@versionChart(v.Versions)
			</section>
		}
		<div class="grid-2">
			<section class="panel">
				<div class="panel-head"><h2>Running</h2></div>
				<table>
					<thead><tr><th>Environment</th><th>Version</th><th>Drift</th></tr></thead>
					<tbody>
						for _, e := range v.Envs {
							<tr>
								<td><strong>{ e.Name }</strong></td>
								<td>
									if len(e.Versions) == 0 {
										<span class="none">not deployed</span>
									}
									for _, ver := range e.Versions {
										<div class="ver"><span class="tag">{ ver.Tag }</span>@resolvedTag(ver.Tag, ver.Resolved)<span class="reps">× { itoa(ver.Running) }</span></div>
										<div class="targets">{ ver.Targets }</div>
									}
								</td>
								<td>
									<div class="badges">
										for _, d := range e.Drifts {
											<span class={ "badge", d.Kind } title={ d.Title }>{ d.Label }</span>
										}
									</div>
									if len(e.Drifts) > 0 {
										<div class="targets">
											{ "open since " }
											@timeAgo(e.Drifts[0].Since)
										</div>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</section>
			<section class="panel">
				<div class="panel-head"><h2>Upstream releases</h2><span class="muted">newest first</span></div>
				<div class="panel-body">
					if len(v.Releases) == 0 {
						<p class="muted">No releases known yet.</p>
					} else {
						<table>
							<tbody>
								for _, r := range v.Releases {
									<tr>
										<td class="mono"><strong>{ r.Version }</strong></td>
										<td class="muted">
											if !r.Published.IsZero() {
												{ r.Published.Format("2006-01-02") }
											}
										</td>
										<td class="num">
											if r.URL != "" {
												<a href={ templ.URL(r.URL) } target="_blank" rel="noopener noreferrer">release notes</a>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					}
					if v.CanMember {
						<details>
							<summary>Quiet notifications</summary>
							<form class="stack" method="post" action={ templ.URL("/services/" + v.Name + "/ack") }>
								<div class="row">
									<label>
										About
										<select name="kind">
											<option value="release">new releases</option>
											<option value="drift">drift</option>
										</select>
									</label>
									<label>
										Until version
										<input name="until_version" placeholder="e.g. 2.1.0"/>
									</label>
									<label>
										Or for
										<select name="for">
											<option value="">—</option>
											<option value="168h">7 days</option>
											<option value="336h">14 days</option>
											<option value="720h">30 days</option>
										</select>
									</label>
								</div>
								<div><button type="submit">Acknowledge</button></div>
							</form>
						</details>
					}
					if len(v.Acks) > 0 {
						<table>
							<thead>
								<tr>
									<th>Quiet</th>
									<th>Until</th>
									<th>By</th>
									if v.CanMember {
										<th></th>
									}
								</tr>
							</thead>
							<tbody>
								for _, a := range v.Acks {
									<tr>
										<td>{ a.Kind }{ envSuffix(a.Env) }</td>
										<td>
											{ a.Until }
											if !a.Active {
												<span class="badge neutral">expired</span>
											}
										</td>
										<td class="muted">{ a.By }</td>
										if v.CanMember {
											<td class="num">
												<form method="post" action={ templ.URL("/services/" + v.Name + "/acks/" + a.ID + "/delete") }>
													<button class="link danger-link" type="submit">Remove</button>
												</form>
											</td>
										}
									</tr>
								}
							</tbody>
						</table>
					}
				</div>
			</section>
		</div>
		<div class="grid-2">
			<section class="panel">
				<div class="panel-head"><h2>History</h2><a href={ templ.URL("/events?service=" + v.Name) }>All events →</a></div>
				@timeline(v.Events, false)
			</section>
			<section class="panel">
				<div class="panel-head">
					<h2>Version policy</h2>
					if v.PolicyFrom == "catalog" {
						<span class="badge neutral" title="This image is in the Goliash catalog; saving the form makes the policy the service's own.">from catalog</span>
					}
				</div>
				<div class="panel-body">
					@releaseNotesSource(v)
					if v.CanMember {
						<form class="stack" method="post" action={ templ.URL("/services/" + v.Name + "/policy") }>
							<div class="row">
								<label>
									Owner
									<input name="owner" value={ v.Owner } placeholder="team-payments"/>
								</label>
								<label>
									Kind
									<select name="kind">
										<option value="own" selected?={ v.Kind != "third_party" }>own</option>
										<option value="third_party" selected?={ v.Kind == "third_party" }>third-party</option>
									</select>
								</label>
							</div>
							<label>
								Upstream repository
								<input name="upstream" value={ v.Upstream } placeholder={ v.RefRepo }/>
								<span class="hint">Empty: the image the service runs.</span>
							</label>
							<div class="row">
								<label>
									Alert from
									<select name="track">
										<option value="patch" selected?={ v.Policy.Track == "patch" || v.Policy.Track == "" }>any new version</option>
										<option value="minor" selected?={ v.Policy.Track == "minor" }>minor versions</option>
										<option value="major" selected?={ v.Policy.Track == "major" }>major versions</option>
									</select>
								</label>
								<label>
									Pin major
									<input name="pin_major" inputmode="numeric" value={ v.Policy.PinMajor } placeholder="e.g. 15"/>
								</label>
							</div>
							<label>
								Tag filter
								<input name="tag_filter" class="mono" value={ v.Policy.TagFilter } placeholder="^\d+\.\d+\.\d+$"/>
								<span class="hint">Regular expression. Empty: tags shaped like the running one.</span>
							</label>
							<label class="check">
								<input type="checkbox" name="prerelease" value="1" checked?={ v.Policy.Prerelease }/>
								Consider alpha, beta and rc tags
							</label>
							<div><button type="submit">Save policy</button></div>
						</form>
					} else {
						<p class="muted">Track { orDash(v.Policy.Track) }, pin { orDash(v.Policy.PinMajor) }, filter <code>{ orDash(v.Policy.TagFilter) }</code>.</p>
					}
				</div>
			</section>
		</div>
		if v.CanAdmin && !v.Runs {
			<section class="panel">
				<div class="panel-head"><h2>Delete service</h2></div>
				<div class="panel-body">
					<p class="muted">{ v.Name } runs nowhere now. Deleting it removes its policy, releases, mapping rules and acknowledgements; its history stays.</p>
					<form method="post" action={ templ.URL("/services/" + v.Name + "/delete") } hx-confirm={ "Delete service " + v.Name + "?" }>
						<button type="submit" class="danger">Delete { v.Name }</button>
					</form>
				</div>
			</section>
		}
	}
}

templ releaseNotesSource(v ServiceView) {
	<p class="hint">
		switch  {
			case v.NotesGitHub != "":
				{ "Release notes: " }
				<a href={ templ.URL("https://github.com/" + v.NotesGitHub + "/releases") } target="_blank" rel="noopener noreferrer">{ v.NotesGitHub }</a>
				{ " " + v.NotesFrom }
			case v.NotesGitLab != "":
				{ "Release notes: " }
				<a href={ templ.URL("https://" + v.NotesGitLab + "/-/releases") } target="_blank" rel="noopener noreferrer">{ v.NotesGitLab }</a>
				{ " " + v.NotesFrom }
			case v.NotesChangelog != "":
				{ "Release notes: " }
				<a href={ templ.URL(v.NotesChangelog) } target="_blank" rel="noopener noreferrer">changelog</a>
				{ " " + v.NotesFrom }
			default:
				{ "No release notes source. Images that set the org.opencontainers.image.source label get one automatically." }
		}
	</p>
}
