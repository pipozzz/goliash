package ui

import (
	"net/url"
	"strings"

	"github.com/pipozzz/goliash/internal/versions"
)

templ ServicePage(v ServiceView) {
	@Layout(v.Base) {
		<div class="head">
			<div>
				<p class="muted"><a href="/">Matrix</a> / service</p>
				<h1>{ v.Name }</h1>
			</div>
			if v.CanMember && v.PublicRegistry {
				<form method="post" action={ templ.URL("/services/" + v.Name + "/check") } class="inline">
					<button class="secondary" type="submit">Check upstream now</button>
				</form>
			}
		</div>
		<dl class="facts">
			<div class="fact">
				<dt>Team</dt>
				<dd>
					if v.CanMember {
						<form method="post" action={ templ.URL("/services/" + v.Name + "/team") } class="inline team-set">
							<input name="team" data-combo="service-teams" data-combo-new="Create team" value={ v.Owner } placeholder="no team" aria-label={ "Team of " + v.Name } size="14"/>
							<button type="submit" class="secondary">Set</button>
						</form>
						<datalist id="service-teams">
							for _, t := range v.TeamNames {
								<option value={ t }></option>
							}
						</datalist>
					} else {
						{ orDash(v.Owner) }
					}
				</dd>
			</div>
			<div class="fact"><dt>Kind</dt><dd>{ kindLabel(v.KindShown) }</dd></div>
			<div class="fact"><dt>Upstream</dt><dd class="mono">{ orDash(v.RefRepo) }</dd></div>
			if v.BuiltOn != nil {
				<div class="fact">
					<dt>Built on</dt>
					<dd>
						<span class="mono" title={ v.BuiltOn.Image }>{ v.BuiltOn.Short }</span>
						if v.BuiltOn.Passed {
							<span class="badge eol" title={ v.BuiltOn.Product + " " + v.BuiltOn.Cycle + " is no longer supported" }>end of life { v.BuiltOn.EOL }</span>
						} else if v.BuiltOn.Soon {
							<span class="badge eol" title={ v.BuiltOn.Product + " " + v.BuiltOn.Cycle + " support ends soon" }>EOL { v.BuiltOn.EOL }</span>
						}
					</dd>
				</div>
			}
			<div class="fact">
				<dt>Latest acceptable</dt>
				<dd>
					<span class="mono">{ orDash(v.Latest) }</span>
					if v.Goli && v.Latest != "" {
						<button type="button" class="link ask-goli noprint" data-goli-ask={ "Brief me on upgrading " + v.Name + " to " + v.Latest + " from what runs in each environment: what breaks or needs migrating, what it fixes (security first), and what to check before and after." } title="Goli reads the release notes and briefs you">Brief</button>
					}
				</dd>
			</div>
			<div class="fact">
				<dt>Last checked</dt>
				<dd>
					if v.Private {
						<span class="muted">by the agent</span>
						if v.CanAdmin && v.RefRepo != "" {
							<a class="link" href={ templ.URL("/settings?registry=" + versions.RegistryHost(v.RefRepo) + "#registries") }>or by the server</a>
						}
					} else {
						@timeAgo(v.CheckedAt)
					}
				</dd>
			</div>
		</dl>
		if v.CheckError != "" {
			<div class="notice error">
				Upstream check failed: { v.CheckError }
				if v.Private && strings.Contains(v.CheckError, "denied") {
					<p class="hint">
						The agents check this registry with their own credentials: a <code>GOLIASH_CREDENTIAL_…</code> variable named after the registry host, a <code>docker login</code> on the host, or the cluster's image pull secrets. Or give the server read access under Settings → Private registries.
						<a href="https://goliash.dev/reference/collectors/#private-registries" target="_blank" rel="noopener">How to give agents credentials</a>
					</p>
				}
			</div>
		}
		for _, is := range v.Rollouts {
			<div class={ "notice", templ.KV("error", is.Kind != versions.RolloutShort) }>
				<strong>{ rolloutHeadline(is) }</strong>
				{ " " + rolloutDetail(is) }
			</div>
		}
		if v.LatestAny != "" && v.LatestAny != v.Latest {
			<p class="muted">{ v.LatestAny } is out, outside the pinned major; it is shown as information, not alerted.</p>
		}
		if len(v.GitOps) > 0 {
			@gitOpsPanel(v.GitOps, v.CanMember || v.PreviewPRs, false)
		} else if v.CanPR && v.CanMember && v.Runs && len(gitLabelSnippets(v.Name, v.Platforms)) > 0 {
			<details class="panel git-tip">
				<summary><strong>Open upgrades as pull requests</strong> <span class="muted">Name where { v.Name } is pinned in Git, and its upgrades open as pull requests from here.</span></summary>
				<div class="panel-body stack">
					for _, sn := range gitLabelSnippets(v.Name, v.Platforms) {
						<div>
							<p class="muted">{ sn.Where }</p>
							<pre class="code"><code>{ sn.Code }</code></pre>
						</div>
					}
					<p class="muted">Change the repository and the path (a file, or a directory of files) to yours; <code>goliash.git.branch</code> picks a branch other than the default. <a href="https://goliash.dev/guide/argocd/#without-argo-cd-or-flux" target="_blank" rel="noopener">How it works</a></p>
				</div>
			</details>
		}
		if len(v.Versions.Lanes) > 0 {
			<section class="panel">
				<div class="panel-head"><h2>Versions over time</h2>@panelInfo("last 30 days; hover for dates")</div>
				@versionChart(v.Versions)
			</section>
		}
		<div class="grid-2">
			<section class="panel">
				<div class="panel-head"><h2>Running</h2></div>
				<div class="scroll" tabindex="0">
					<table>
						<thead><tr><th>Environment</th><th>Version</th><th>Drift</th></tr></thead>
						<tbody>
							for _, e := range v.Envs {
								if len(e.Versions) <= 1 {
									<tr>
										<td><strong>{ e.Name }</strong></td>
										<td>
											if len(e.Versions) == 0 {
												<span class="none">not deployed</span>
											}
											for _, ver := range e.Versions {
												@runningVersion(ver)
											}
										</td>
										<td>
											@driftCell(e.Drifts)
										</td>
									</tr>
								} else {
									for i, ver := range e.Versions {
										<tr class={ templ.KV("same-env", i > 0) }>
											if i == 0 {
												<td rowspan={ itoa(len(e.Versions)) }>
													<strong>{ e.Name }</strong>
													<div class="targets">{ itoa(len(e.Versions)) } versions</div>
												</td>
											}
											<td>
												@runningVersion(ver)
											</td>
											<td>
												if i == 0 {
													@driftCell(append(append([]DriftBadge{}, e.Drifts...), ver.Drifts...))
												} else {
													@versionDrifts(ver.Drifts)
												}
												if len(ver.Drifts) == 0 && (i > 0 || len(e.Drifts) == 0) {
													<span class="muted">no drift</span>
												}
											</td>
										</tr>
									}
								}
							}
						</tbody>
					</table>
				</div>
			</section>
			<section class="panel">
				<div class="panel-head"><h2>Upstream releases</h2>@panelInfo("newest first")</div>
				<div class="panel-body">
					if len(v.Releases) == 0 {
						<p class="muted">No releases known yet.</p>
					} else {
						<div class="scroll" tabindex="0">
							<table>
								<tbody>
									for _, r := range v.Releases {
										<tr>
											<td class="mono"><strong>{ r.Version }</strong></td>
											<td class="muted">
												if !r.Published.IsZero() {
													{ r.Published.Format("2006-01-02") }
												}
											</td>
											<td class="num">
												if r.URL != "" {
													<a href={ templ.URL(r.URL) } target="_blank" rel="noopener noreferrer">release notes</a>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
					if v.CanMember {
						<details>
							<summary>Quiet notifications</summary>
							<form class="stack" method="post" action={ templ.URL("/services/" + v.Name + "/ack") }>
								<div class="row">
									<label>
										About
										<select name="kind">
											<option value="release">new releases</option>
											<option value="drift">drift</option>
										</select>
									</label>
									<label>
										Until version
										<input name="until_version" placeholder="e.g. 2.1.0"/>
									</label>
									<label>
										Or for
										<select name="for">
											<option value="">—</option>
											<option value="168h">7 days</option>
											<option value="336h">14 days</option>
											<option value="720h">30 days</option>
										</select>
									</label>
								</div>
								<div><button type="submit">Acknowledge</button></div>
							</form>
						</details>
					}
					if len(v.Acks) > 0 {
						<div class="scroll" tabindex="0">
							<table>
								<thead>
									<tr>
										<th>Quiet</th>
										<th>Until</th>
										<th>By</th>
										if v.CanMember {
											<th><span class="sr-only">Actions</span></th>
										}
									</tr>
								</thead>
								<tbody>
									for _, a := range v.Acks {
										<tr>
											<td>{ a.Kind }{ envSuffix(a.Env) }</td>
											<td>
												{ a.Until }
												if !a.Active {
													<span class="badge neutral">expired</span>
												}
											</td>
											<td class="muted">{ a.By }</td>
											if v.CanMember {
												<td class="num">
													<form method="post" action={ templ.URL("/services/" + v.Name + "/acks/" + a.ID + "/delete") }>
														<button class="link danger-link" type="submit">Remove</button>
													</form>
												</td>
											}
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>
			</section>
		</div>
		if len(v.Security.Images) > 0 {
			@serviceSecurity(v)
		}
		if len(v.Sizes.Series) > 0 || v.SizeChange != nil {
			<section class="panel" id="sizes">
				<div class="panel-head"><h2>Image size</h2>@panelInfo("MB pulled, per environment, last 90 days")</div>
				if len(v.Sizes.Series) > 0 {
					<div class="panel-body">
						@lines(v.Sizes, "Image size in MB per environment, last 90 days")
					</div>
				}
				if c := v.SizeChange; c != nil {
					@sizeChange(c)
				}
			</section>
		}
		<div class="grid-2">
			<section class="panel">
				<div class="panel-head"><h2>History</h2><a href={ templ.URL("/events?service=" + v.Name) }>All events →</a></div>
				@timeline(v.Events, false)
			</section>
			<section class="panel">
				<div class="panel-head">
					<h2>Version policy</h2>
					if v.PolicyFrom == "catalog" {
						<span class="badge neutral" title="This image is in the Goliash catalog; saving the form makes the policy the service's own.">from catalog</span>
					}
				</div>
				<div class="panel-body">
					@releaseNotesSource(v)
					if v.CanMember {
						<form class="stack" method="post" action={ templ.URL("/services/" + v.Name + "/policy") }>
							<div class="row">
								<label>
									Owner
									<input name="owner" value={ v.Owner } placeholder="team-payments"/>
									switch v.OwnerSource {
										case "label":
											<span class="hint">From its workloads' team label; changing it here takes over from the label.</span>
										case "app":
											<span class="hint">From its application's team; changing it here takes over.</span>
									}
								</label>
								<label>
									Application
									<input name="app" value={ v.App } placeholder="from its labels"/>
									<span class="hint">Set it to place the service in one application whatever its labels say.</span>
								</label>
								<label>
									Kind
									<select name="kind">
										<option value="" selected?={ !v.KindChosen }>{ "from the image: " + kindLabel(v.KindAuto) }</option>
										<option value="own" selected?={ v.KindChosen && v.Kind != "third_party" }>own</option>
										<option value="third_party" selected?={ v.KindChosen && v.Kind == "third_party" }>third-party</option>
									</select>
								</label>
							</div>
							<label>
								Upstream repository
								<input name="upstream" value={ v.Upstream } placeholder={ v.RefRepo }/>
								<span class="hint">Empty: the image the service runs.</span>
							</label>
							<div class="row">
								<label>
									Alert from
									<select name="track">
										<option value="patch" selected?={ v.Policy.Track == "patch" || v.Policy.Track == "" }>any new version</option>
										<option value="minor" selected?={ v.Policy.Track == "minor" }>minor versions</option>
										<option value="major" selected?={ v.Policy.Track == "major" }>major versions</option>
									</select>
								</label>
								<label>
									Pin major
									<input name="pin_major" inputmode="numeric" value={ v.Policy.PinMajor } placeholder="e.g. 15"/>
								</label>
							</div>
							<label>
								Tag filter
								<input name="tag_filter" class="mono" value={ v.Policy.TagFilter } placeholder="^\d+\.\d+\.\d+$"/>
								<span class="hint">Regular expression. Empty: tags shaped like the running one.</span>
							</label>
							<label>
								Base image
								<input name="base_image" class="mono" value={ v.Policy.BaseImage } placeholder="node:22-alpine"/>
								<span class="hint">What the service's image is built FROM, tracked for end of life. Empty: as the image declares (org.opencontainers.image.base.name); none: not tracked.</span>
							</label>
							<label>
								Image size budget (MB)
								<input name="max_size_mb" inputmode="numeric" value={ v.Policy.MaxSizeMB } placeholder="e.g. 300"/>
								<span class="hint">What pulling the image may download. Over it, Image hygiene lists it and the image over budget alert fires. Empty: no budget.</span>
							</label>
							<label>
								Expected signer
								<input name="signer" value={ v.Policy.Signer } placeholder="https://github.com/acme/*"/>
								<span class="hint">Who should sign its images, as keyless signatures' certificates name it: a workflow URI or email, or a prefix ending in *. An image not signed by it shows under Image hygiene.</span>
							</label>
							<label>
								Automatic pull requests
								<input name="auto_pr" value={ v.Policy.AutoPR } placeholder="dev=minor, staging=patch"/>
								<span class="hint">Per environment, the biggest jump Goliash opens a pull request for by itself, in the repository its Argo CD or Flux application deploys from. Empty: only when someone asks.</span>
							</label>
							<label>
								Pull request reviewers
								<input name="pr_reviewers" value={ v.Policy.Reviewers } placeholder="alice, @acme/payments"/>
								<span class="hint">{ "Asked to review the pull requests Goliash opens for it: people, and teams as @org/team." }</span>
							</label>
							<label>
								Pull request labels
								<input name="pr_labels" value={ v.Policy.Labels } placeholder="dependencies, goliash"/>
							</label>
							<label class="check">
								<input type="checkbox" name="prerelease" value="1" checked?={ v.Policy.Prerelease }/>
								Consider alpha, beta and rc tags
							</label>
							<div><button type="submit">Save policy</button></div>
						</form>
					} else {
						<p class="muted">Track { orDash(v.Policy.Track) }, pin { orDash(v.Policy.PinMajor) }, filter <code>{ orDash(v.Policy.TagFilter) }</code>.</p>
					}
				</div>
			</section>
		</div>
		if len(v.Badges) > 0 {
			<section class="panel">
				<div class="panel-head"><h2>Badges</h2>@panelInfo("to embed in a README or a wiki")</div>
				<div class="panel-body embed-badges">
					<p class="muted">Each badge shows the version and its state, updated within minutes. Its address is signed: it works without signing in, for this service and environment only.</p>
					for i, b := range v.Badges {
						<div class="badge-row">
							<img src={ b.URL } alt={ "badge " + v.Name + " " + b.Env } height="20"/>
							<span class="muted">
								if b.Env == "" {
									every environment
								} else {
									{ b.Env }
								}
							</span>
							<button type="button" class="link" data-copy={ "badge-md-" + itoa(i) }>Copy markdown</button>
							<pre id={ "badge-md-" + itoa(i) } hidden>{ b.Markdown }</pre>
						</div>
					}
				</div>
			</section>
		}
		if len(v.Manual) > 0 || v.CanMember {
			@manualPanel(v)
		}
		if v.CanMember && len(v.Split) > 1 {
			<section class="panel">
				<div class="panel-head"><h2>Split by application</h2><span class="muted">it runs in { itoa(len(v.Split)) } applications</span></div>
				<div class="panel-body">
					<form class="stack" method="post" action={ templ.URL("/services/" + v.Name + "/split") }>
						<p class="hint">
							Each application below gets the service named next to it; the one named { v.Name } stays. Their
							workloads move with their history, and a rule keeps them there. Keep a name to leave an
							application as it is.
						</p>
						for _, a := range v.Split {
							<div class="row split-row">
								<input type="hidden" name="app" value={ a.App }/>
								<span><strong>{ a.App }</strong> <span class="muted">{ plural(a.Workloads, "workload", "workloads") }</span></span>
								<label class="sr-only" for={ "split-" + a.App }>Service for { a.App }</label>
								<input id={ "split-" + a.App } name="name" value={ a.Name } required maxlength="100"/>
							</div>
						}
						<div><button class="secondary" type="submit">Split</button></div>
					</form>
				</div>
			</section>
		}
		if v.CanMember {
			<section class="panel">
				<div class="panel-head"><h2>Rename</h2></div>
				<div class="panel-body">
					<form class="stack" method="post" action={ templ.URL("/services/" + v.Name + "/rename") }>
						<div class="row">
							<label>New name<input name="to" value={ v.Name } required maxlength="100"/></label>
						</div>
						<label class="check"><input type="checkbox" name="merge" value="1"/> If a service has that name, merge into it</label>
						<p class="hint">A shared image first mapped under one project's name (cefiro-redis) is better called after the image (redis). Merging moves this service's workloads, history, mapping rules and acknowledgements to the other one and deletes this one.</p>
						<div><button class="secondary" type="submit">Rename</button></div>
					</form>
				</div>
			</section>
		}
		if v.CanAdmin && !v.Runs {
			<section class="panel">
				<div class="panel-head"><h2>Delete service</h2></div>
				<div class="panel-body">
					<p class="muted">{ v.Name } runs nowhere now. Deleting it removes its policy, releases, mapping rules and acknowledgements; its history stays.</p>
					<form method="post" action={ templ.URL("/services/" + v.Name + "/delete") } hx-confirm={ "Delete service " + v.Name + "?" }>
						<button type="submit" class="danger">Delete { v.Name }</button>
					</form>
				</div>
			</section>
		}
	}
}

templ releaseNotesSource(v ServiceView) {
	<p class="hint">
		switch  {
			case v.NotesGitHub != "":
				{ "Release notes: " }
				<a href={ templ.URL("https://github.com/" + v.NotesGitHub + "/releases") } target="_blank" rel="noopener noreferrer">{ v.NotesGitHub }</a>
				{ " " + v.NotesFrom }
			case v.NotesGitLab != "":
				{ "Release notes: " }
				<a href={ templ.URL("https://" + v.NotesGitLab + "/-/releases") } target="_blank" rel="noopener noreferrer">{ v.NotesGitLab }</a>
				{ " " + v.NotesFrom }
			case v.NotesChangelog != "":
				{ "Release notes: " }
				<a href={ templ.URL(v.NotesChangelog) } target="_blank" rel="noopener noreferrer">changelog</a>
				{ " " + v.NotesFrom }
			default:
				{ "No release notes source. Images that set the org.opencontainers.image.source label get one automatically." }
		}
	</p>
}

templ runningVersion(ver VersionView) {
	<div class="ver"><span class="tag">{ ver.Tag }</span>@resolvedTag(ver.Tag, ver.Resolved)<span class="reps">× { itoa(ver.Running) }</span></div>
	<div class="targets">{ ver.Targets }</div>
}

// driftCell is the drift badges of an environment or a version, and how long the oldest has been open.
templ driftCell(drifts []DriftBadge) {
	if len(drifts) > 0 {
		<div class="badges">
			for _, d := range drifts {
				<span class={ "badge", d.Kind } title={ d.Title }>{ d.Label }</span>
			}
		</div>
		<div class="targets">
			{ "open since " }
			@timeAgo(oldestDrift(drifts))
		</div>
	}
}

// versionDrifts is the badges of a version beside the first; some are not tracked drifts, so no "open since".
templ versionDrifts(drifts []DriftBadge) {
	if len(drifts) > 0 {
		<div class="badges">
			for _, d := range drifts {
				<span class={ "badge", d.Kind } title={ d.Title }>{ d.Label }</span>
			}
		</div>
		if !drifts[0].Since.IsZero() {
			<div class="targets">
				{ "open since " }
				@timeAgo(oldestDrift(drifts))
			</div>
		}
	}
}

// manualPanel lists and edits where the service runs outside what Goliash collects: a virtual machine,
// a managed database, an appliance.
templ manualPanel(v ServiceView) {
	<section class="panel">
		<div class="panel-head"><h2>Runs outside Goliash</h2>@panelInfo("versions entered by hand: a VM, a managed service")</div>
		<div class="panel-body stack">
			if len(v.Manual) > 0 {
				<div class="scroll" tabindex="0">
					<table>
						<thead><tr><th>Environment</th><th>Where</th><th>Version</th><th><span class="sr-only">Remove</span></th></tr></thead>
						<tbody>
							for _, m := range v.Manual {
								<tr>
									<td>{ m.Env }</td>
									<td>{ m.Where }</td>
									<td class="mono">{ m.Version }</td>
									<td class="num">
										if v.CanMember {
											<form class="inline" method="post" action={ templ.URL("/services/" + v.Name + "/manual") } hx-confirm={ "Remove " + v.Name + " from " + m.Where + "?" }>
												<input type="hidden" name="env" value={ m.Env }/>
												<input type="hidden" name="where" value={ m.Where }/>
												<input type="hidden" name="version" value=""/>
												<button class="link" type="submit">Remove</button>
											</form>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			} else {
				<p class="hint">Runs somewhere Goliash does not collect, such as a virtual machine or a managed database? Enter it, and it counts in the matrix, updates, end of life and the security posture.</p>
			}
			if v.CanMember && len(v.EnvNames) > 0 {
				<form class="row" method="post" action={ templ.URL("/services/" + v.Name + "/manual") }>
					<label>
						Environment
						<select name="env">
							for _, e := range v.EnvNames {
								<option>{ e }</option>
							}
						</select>
					</label>
					<label>Where<input name="where" required maxlength="100" placeholder="db-vm-1"/></label>
					<label>Version<input name="version" required maxlength="128" placeholder="16.4"/></label>
					<div><button class="secondary" type="submit">Save</button></div>
				</form>
				<p class="hint">Enter a new version under the same Where to record an upgrade; it shows in the history.</p>
			}
		</div>
	</section>
}

// serviceSecurity is what the registry and the images' SBOMs say about the images the service runs.
templ serviceSecurity(v ServiceView) {
	{{ sec := v.Security }}
	<section class="panel" id="security">
		<div class="panel-head">
			<h2>Security</h2>
			<span class="muted">
				if sec.Exploited > 0 {
					<span class="badge exploited">{ plural(sec.Exploited, "exploited vulnerability", "exploited vulnerabilities") }</span>
				}
				if sec.Total > 0 {
					{ plural(sec.Total, "known vulnerability", "known vulnerabilities") } · <a href={ templ.URL("/security/vulns?env=all&q=" + v.Name) }>All of them →</a>
				} else if sec.WithSBOM > 0 {
					no known vulnerabilities in its SBOMs
				} else {
					no SBOM to check
				}
			</span>
		</div>
		<div class="scroll" tabindex="0">
			<table class="cards">
				<thead><tr><th>Environment</th><th>Image</th><th class="num">Size</th><th>Signed</th><th>SBOM</th><th>Provenance</th></tr></thead>
				<tbody>
					for _, im := range sec.Images {
						<tr>
							<td><strong>{ im.Env }</strong></td>
							<td data-label="Image">
								<code title={ im.Digest }>{ im.Image }</code>
								if im.OldBase != "" {
									<a class="badge outdated" style="margin-left:6px" href="/hygiene?kind=outdated-base" title={ "Built on an older " + im.OldBase + " than its tag has now: rebuild with --pull to get its fixes" }>older base</a>
								}
							</td>
							<td class="num" data-label="Size">
								if im.Size > 0 {
									{ humanBytes(im.Size) }
									if im.Delta != 0 {
										<span class={ "muted size-delta", templ.KV("grew", im.Delta > 0) } title={ "against " + im.DeltaFrom }>{ signedBytes(im.Delta) }</span>
									}
								} else {
									<span class="muted">—</span>
								}
							</td>
							if !im.Checked {
								<td colspan="3" class="muted" data-label="Evidence">not checked yet</td>
							} else {
								<td data-label="Signed">
									@evidenceMark(im.Signed)
									if im.Signer != "" {
										<div class="targets mono" title={ im.SignerFull }>{ im.Signer }</div>
									}
								</td>
								<td data-label="SBOM">@evidenceMark(im.SBOM)</td>
								<td data-label="Provenance">@evidenceMark(im.Provenance)</td>
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
		if len(sec.Findings) > 0 {
			<div class="scroll" style="border-top:1px solid var(--line)">
				<table class="cards">
					<thead><tr><th>Vulnerability</th><th>Severity</th><th>Package</th><th>Where</th></tr></thead>
					<tbody>
						for _, f := range sec.Findings {
							<tr>
								<td>
									<a href={ templ.URL("/security/vulns?env=all&q=" + f.Key) }><strong>{ f.Key }</strong></a>
									if f.Summary != "" {
										<div class="targets">{ f.Summary }</div>
									}
								</td>
								<td data-label="Severity">
									if f.Exploited {
										<span class="badge exploited">exploited</span>
									}
									if f.Severity != "" {
										<span class="muted">{ strings.ToLower(f.Severity) }</span>
									}
								</td>
								<td data-label="Package">
									<code>{ f.Package }</code>
									if f.Fix != "" {
										<div class="targets">{ "fixed in " + f.Fix }</div>
									} else {
										<div class="targets">no fix yet</div>
									}
								</td>
								<td data-label="Where">{ f.Envs }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			if sec.More > 0 {
				<div class="panel-body"><a href={ templ.URL("/security/vulns?env=all&q=" + v.Name) }>{ plural(sec.More, "more", "more") } →</a></div>
			}
		}
	</section>
}

templ evidenceMark(ok bool) {
	if ok {
		<span class="badge ok">yes</span>
	} else {
		<span class="muted">no</span>
	}
}

// sizeChange lists the layers the last deploy in an environment added and removed, with the build steps that made
// them: what made the image bigger or smaller.
templ sizeChange(c *SizeChange) {
	<div class="panel-body size-change">
		<h3>
			{ "Last change in " + c.Env + ": " + orDash(c.From) + " → " + orDash(c.To) + ", " }
			if c.After >= c.Before {
				<span class={ templ.KV("grew", c.After-c.Before >= 20_000_000) }>{ signedBytes(c.After - c.Before) }</span>
			} else {
				<span>{ signedBytes(c.After - c.Before) }</span>
			}
		</h3>
		<div class="scroll" tabindex="0">
			<table class="cards">
				<thead><tr><th class="num">Size</th><th>Layer</th><th>Build step</th></tr></thead>
				<tbody>
					for _, l := range c.Added {
						<tr>
							<td class="num" data-label="Size">{ "+" + humanBytes(l.Size) }</td>
							<td data-label="Layer"><span class="badge outdated">new</span></td>
							<td data-label="Build step"><code>{ orDash(l.Command) }</code></td>
						</tr>
					}
					for _, l := range c.Removed {
						<tr class="muted">
							<td class="num" data-label="Size">{ "−" + humanBytes(l.Size) }</td>
							<td data-label="Layer"><span class="badge neutral">gone</span></td>
							<td data-label="Build step"><code>{ orDash(l.Command) }</code></td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if c.AddedN > len(c.Added) || c.RemovedN > len(c.Removed) {
			<p class="hint">{ "The biggest of " + itoa(c.AddedN) + " new and " + itoa(c.RemovedN) + " gone layers; layers both versions share (the base, unchanged steps) are left out." }</p>
		} else {
			<p class="hint">Layers both versions share (the base, unchanged steps) are left out.</p>
		}
	</div>
}

// gitOpsPanel shows the GitOps applications (Argo CD, Flux) that deploy the service: where from, which commit, in sync or not.
templ gitOpsPanel(apps []GitOpsView, canEdit, all bool) {
	<section class="panel" id="gitops">
		if !all {
			<div class="panel-head"><h2>{ gitOpsTitle(apps) }</h2><a class="muted" href="/gitops">All applications →</a>@panelInfo("what Git declares, and whether it runs")</div>
		}
		<div class="scroll" tabindex="0">
			<table class="cards">
				<thead>
					<tr>
						if all {
							<th>Service</th>
						}
						<th>Application</th><th>Where</th><th>From</th><th>Synced</th><th>State</th>
					</tr>
				</thead>
				<tbody>
					for _, a := range apps {
						<tr>
							if all {
								<td data-label="Service" class="svc"><a href={ templ.URL(serviceURL(a.Service)) }><strong>{ a.Service }</strong></a></td>
							}
							<td data-label="Application">
								if a.AppURL != "" {
									<a href={ templ.SafeURL(a.AppURL) } rel="noopener" target="_blank"><strong>{ a.App }</strong></a>
								} else {
									<strong>{ a.App }</strong>
								}
								<div class="targets">{ a.Workload }</div>
							</td>
							<td data-label="Where">{ a.Environment }<div class="targets">{ a.Target }</div></td>
							<td data-label="From">
								if a.RepoURL != "" {
									<a href={ templ.SafeURL(a.RepoURL) } rel="noopener" target="_blank" class="mono">{ a.Repo }</a>
								} else {
									<span class="mono">{ orDash(a.Repo) }</span>
								}
								<div class="targets">{ a.Path }
									if a.TargetRevision != "" {
										{ " @ " + a.TargetRevision }
									}
								</div>
							</td>
							<td data-label="Synced" class="mono">
								if a.CommitURL != "" {
									<a href={ templ.SafeURL(a.CommitURL) } rel="noopener" target="_blank">{ a.Revision }</a>
								} else {
									{ orDash(a.Revision) }
								}
								if a.CompareURL != "" {
									<div class="targets"><a href={ templ.SafeURL(a.CompareURL) } rel="noopener" target="_blank" title="What changed in Git since the commit synced before">changes</a> @timeAgo(a.RevisionAt)</div>
								}
							</td>
							<td data-label="State">
								<span class="badges">
									if a.Sync != "" {
										<span class={ "badge", syncBadge(a.Sync) }>{ a.Sync }</span>
									}
									if a.Health != "" {
										<span class={ "badge", syncBadge(a.Health) }>{ a.Health }</span>
									}
									if a.SyncWindow != "" {
										<span class="badge neutral sync-window" title={ a.SyncWindow }>sync window</span>
									}
								</span>
								if a.Sync != "" || a.Health != "" {
									<div class="targets">since @timeAgo(a.Since)</div>
								} else {
									<div class="targets">from goliash.git labels</div>
								}
								if a.GitPins != "" {
									<div class="git-pins" title={ a.Path + " on " + a.TargetRevision + " pins " + a.GitPins + "; " + a.Tag + " runs: the change has not been synced" }>Git pins <span class="mono">{ a.GitPins }</span>, runs <span class="mono">{ a.Tag }</span></div>
								}
								if a.PRURL != "" {
									<a class="gitops-pr" href={ templ.SafeURL(a.PRURL) } target="_blank" rel="noopener" title={ othersTitle(a.PRTitle) }>{ pullLabel(a.To, a.PRState) }</a>@prChecks(a.PRChecks)
								} else if canEdit && a.To != "" {
									<a class="button secondary gitops-pr" href={ templ.URL("/services/" + url.PathEscape(a.Service) + "/gitops/preview?" + previewQuery(a.TargetID, a.WorkloadID, a.To, gitOpsReturn(all))) } title={ "See the pull request that pins " + a.To + " in " + a.Path + " before opening it" }>Open PR → { a.To }</a>
								}
								if a.RollbackPRURL != "" {
									<a class="gitops-pr" href={ templ.SafeURL(a.RollbackPRURL) } target="_blank" rel="noopener">Rollback PR → { a.Rollback }</a>
								} else if canEdit && a.Rollback != "" {
									<a class="button secondary gitops-pr rollback" href={ templ.URL("/services/" + url.PathEscape(a.Service) + "/gitops/preview?" + previewQuery(a.TargetID, a.WorkloadID, a.Rollback, gitOpsReturn(all))) } title={ "Why: " + a.RollbackWhy + ". See the pull request that pins " + a.Rollback + " again before opening it." }>Rollback PR → { a.Rollback }</a>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
}
